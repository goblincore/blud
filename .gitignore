# dev tooling
scripts/.venv/

# Extracted Blood assets are dev-only placeholders — never commit.
public/assets/**/*-placeholder.*
public/assets/**/placeholder/
public/assets/**/*-placeholder/
assets-source/blood-extracted/
__pycache__/

# Map research artifacts — dev-only, never ship
public/assets/map-research/

# Baked palette LUT — regenerated from BLOOD.RFF via scripts/build_palette_lut.py
public/assets/post-fx/

# Dev-only Blood SFX placeholders — never ship.
# Two patterns: the directory (real extraction) AND the bare path (for when a
# dispatch worktree runs and its helper code symlinks back to main's extraction).
public/assets/audio-placeholder/
public/assets/audio-placeholder

# Dispatch worktree artifacts (see CLAUDE.md — .claude lives outside the repo)
.claude

# Local scratch — throwaway probe scripts, never shipped
.scratch/

# Reference models are dev-only and untracked: a dispatch worktree auto-commit once swept a 116 MB .glb into main (2026-09-05).
# The nine models already tracked on origin stay tracked (ignore rules do not untrack).
docs/dev-notes/refs/**/*.glb
# Local manual gameplay captures (never assets or cross-session agent memory).
telemetry/

# Lab capture scratch: LAB_TMP (scripts/lab-servers.sh) points here when the
# lab runs under a sandbox that only permits writes inside the worktree — it
# holds a throwaway Chrome profile and the vite/chrome logs. Disposable, and
# a Chrome profile is tens of MB, so it must never be committed. Dispatch
# agents have already committed scratch to the repo root once.
.lab-tmp/
.tmp-chrome*/
