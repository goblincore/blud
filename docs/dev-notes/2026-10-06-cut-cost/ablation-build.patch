+// src/lab/sdf-zombie/cut-ablate.ts
+//
+// TEMPORARY (cut-cost investigation, 2026-10-06; NOT for commit): shader-text ablation switches for the cut wound,
+// read once from the page URL (`?cutab=nopinch,nolip`). Off everywhere there is no `location` (vitest), so the golden
+// text and every test see the shipped shader.
+const raw = typeof location !== 'undefined' ? new URLSearchParams(location.search).get('cutab') ?? '' : '';
+const set = new Set(raw.split(',').filter(Boolean));
+export const CUT_AB = {
+  has: (k: string) => set.has(k),
+  raw,
+};
