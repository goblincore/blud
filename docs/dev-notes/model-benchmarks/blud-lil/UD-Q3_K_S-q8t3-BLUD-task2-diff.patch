+  nextGaussian(): number {
+    // Box-Muller transform: two uniform [0,1) values → two standard normals
+    // We cache one result so we only consume one RNG value per call on average.
+    const u1 = this.next();
+    const u2 = this.next();
+    // Guard against log(0)
+    if (u1 === 0) {
+      return this.nextGaussian();
+    }
+    return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
+  }
