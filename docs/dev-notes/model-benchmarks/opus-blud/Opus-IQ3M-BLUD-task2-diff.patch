+  /**
+   * Returns a normally-distributed number (mean 0, stddev 1) using the
+   * Box-Muller transform. Calls this.next() twice per sample.
+   */
+  nextGaussian(): number {
+    // Box-Muller: two uniforms → one standard-normal sample.
+    const u1 = this.next(); // (0, 1)
+    const u2 = this.next(); // (0, 1)
+    const mag = Math.sqrt(-2.0 * Math.log(u1));
+    const z0 = mag * Math.cos(2.0 * Math.PI * u2);
+    return z0;
+  }
