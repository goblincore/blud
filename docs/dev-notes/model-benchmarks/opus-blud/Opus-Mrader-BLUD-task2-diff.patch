@@ -104,4 +104,24 @@ describe('SeededRng', () => {
     // Different positions in the stream → different values
     expect(aVal).not.toBe(bVal);
   });
+
+  it('nextGaussian produces normally distributed values', () => {
+    const rng = new SeededRng(12345);
+    const n = 10000;
+    const samples: number[] = [];
+    for (let i = 0; i < n; i++) {
+      samples.push(rng.nextGaussian());
+    }
+
+    const sum = samples.reduce((a, b) => a + b, 0);
+    const mean = sum / n;
+    const variance =
+      samples.reduce((acc, val) => acc + (val - mean) ** 2, 0) / n;
+    const stddev = Math.sqrt(variance);
+
+    // Sample mean should be within 0.1 of 0 (expected stddev of mean ≈ 0.01)
+    expect(Math.abs(mean)).toBeLessThan(0.1);
+    // Sample stddev should be within 0.1 of 1
+    expect(Math.abs(stddev - 1)).toBeLessThan(0.1);
+  });
 });
