+  it('nextGaussian returns normally-distributed values', () => {
+    const rng = new SeededRng(12345);
+    const n = 10000;
+    const samples: number[] = [];
+    for (let i = 0; i < n; i++) {
+      samples.push(rng.nextGaussian());
+    }
+
+    const sum = samples.reduce((a, b) => a + b, 0);
+    const mean = sum / n;
+
+    const sumSq = samples.reduce((a, b) => a + (b - mean) ** 2, 0);
+    const stddev = Math.sqrt(sumSq / n);
+
+    expect(mean).toBeCloseTo(0, 1); // within 0.1 of 0
+    expect(stddev).toBeCloseTo(1, 1); // within 0.1 of 1
+  });
+
