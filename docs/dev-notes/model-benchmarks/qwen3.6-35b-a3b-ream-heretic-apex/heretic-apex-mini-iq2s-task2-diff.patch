@@ -83,6 +83,23 @@ describe('SeededRng', () => {
     expect(original).toEqual([1, 2, 3, 4, 5, 6, 7, 8]); // input not mutated
   });
 
+  it('nextGaussian returns normally distributed values', () => {
+    const rng = new SeededRng(42);
+    const samples: number[] = [];
+    const n = 10000;
+    for (let i = 0; i < n; i++) {
+      samples.push(rng.nextGaussian());
+    }
+    const mean = samples.reduce((a, b) => a + b, 0) / n;
+    const variance = samples.reduce((a, b) => a + (b - mean) ** 2, 0) / n;
+    const stddev = Math.sqrt(variance);
+
+    // Mean should be within 0.1 of 0
+    expect(Math.abs(mean)).toBeLessThan(0.1);
+    // Stddev should be within 0.1 of 1
+    expect(Math.abs(stddev - 1)).toBeLessThan(0.1);
+  });
+
