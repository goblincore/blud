diff --git a/src/engine/rng.ts b/src/engine/rng.ts
index 737d432..feea01e 100644
--- a/src/engine/rng.ts
+++ b/src/engine/rng.ts
@@ -15,6 +15,27 @@ export class SeededRng {
     return (this.state >>> 0) / 4294967296;
   }
 
+  private gaussianSeedReady: boolean = false;
+  private gaussianMag: number = 0;
+  private gaussianTheta: number = 0;
+
+  nextGaussian(): number {
+    if (!this.gaussianSeedReady) {
+      // Box-Muller transform: need two uniform randoms in (0, 1)
+      let u1 = this.next();
+      let u2 = this.next();
+      // Avoid ln(0) — retry if u1 is exactly 0
+      while (u1 === 0) u1 = this.next();
+      this.gaussianMag = Math.sqrt(-2 * Math.log(u1));
+      this.gaussianTheta = 2 * Math.PI * u2;
+      this.gaussianSeedReady = true;
+      return this.gaussianMag * Math.cos(this.gaussianTheta);
+    } else {
+      this.gaussianSeedReady = false;
+      return this.gaussianMag * Math.sin(this.gaussianTheta);
+    }
+  }
+
   next(): number {
     return this.mulberry32();
   }
