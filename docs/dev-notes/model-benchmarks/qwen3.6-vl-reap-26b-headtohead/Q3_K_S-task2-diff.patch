+  it('nextGaussian returns normally distributed values (mean ~0, stddev ~1)', () => {
+    const rng = new SeededRng(12345);
+    const samples: number[] = [];
+    for (let i = 0; i < 10000; i++) {
+      samples.push(rng.nextGaussian());
+    }
+    const mean = samples.reduce((a, b) => a + b, 0) / samples.length;
+    const variance = samples.reduce((sum, v) => sum + (v - mean) ** 2, 0) / samples.length;
+    const stddev = Math.sqrt(variance);
+    expect(Math.abs(mean)).toBeLessThan(0.1);
+    expect(Math.abs(stddev - 1)).toBeLessThan(0.1);
+  });
