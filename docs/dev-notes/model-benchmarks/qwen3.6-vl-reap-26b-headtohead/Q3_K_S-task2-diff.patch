+    while (u1 <= Number.EPSILON) {
+      u1 = this.next();
+    }
+    const u2: number = this.next();
+    const mag = Math.sqrt(-2.0 * Math.log(u1));
+    const z = mag * Math.cos(2.0 * Math.PI * u2);
