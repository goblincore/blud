+  it('nextGaussian returns values with correct distribution', () => {
+    const rng = new SeededRng(42);
+    const n = 10000;
+    const samples: number[] = [];
+    for (let i = 0; i < n; i++) {
+      samples.push(rng.nextGaussian());
+    }
+    const sum = samples.reduce((a, b) => a + b, 0);
+    const mean = sum / n;
+    const variance = samples.reduce((acc, x) => acc + (x - mean) ** 2, 0) / n;
+    const stddev = Math.sqrt(variance);
+    expect(mean).toBeGreaterThan(-0.1);
+    expect(mean).toBeLessThan(0.1);
+    expect(stddev).toBeGreaterThan(0.9);
+    expect(stddev).toBeLessThan(1.1);
+  });
