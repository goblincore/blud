    "gib:assets:check": "tsx scripts/build-gib-assets.ts --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "postprocessing": "^6.39.1",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "happy-dom": "^15.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
