# THE CEREBRAX — a boss: a huge naked brain clamped into a bone-metal harness
# on four long jointed spider legs, a chaingun slung under its face (owner
# request, 2026-11-08: a "spider mastermind-style" cybernetic enemy, the
# brain pulsing, hooked into a sculpted metal spider body; a reference image
# was shown and is NOT in the repo). The gibbet's lesson applies: the MACHINE
# is the body and the flesh is the cargo. Here the cargo is the mind.
#
# THE SPLIT (biomech-style.md, "Split the body by what is cheap"):
#   - the brain is a handful of SDF prims: the mass, the two hemispheres, the
#     frontal, temporal and occipital lobes, a small snarling face low on the
#     front. Its gyri and sulci, the veins and the wrinkles round the face are
#     ALL baked normal map (characters/cerebrax.detail, generated by
#     scripts/cerebrax-detail-gen.ts), never prims;
#   - the harness ring, the legs, the joints, the feet, the cables and the
#     under-barrel gun are sculpted kit (assets-source/cerebrax-kit/), with the
#     red eye embers and the cable ends glowing through the baked `_glow`.
#
# THE RIG is the gibbet's four-legged one on the standard biped names
# (biomech-style.md, "Non-humanoid rigs"): arms as front legs ('foreleg'),
# the thighs as hind legs. What is new is the leg's SHAPE: a spider's, the
# knee carried HIGH above the body and the shin dropping long and nearly
# straight to a point on the floor. The gait's planted-leg IK poles the
# knee up and out (GaitProfile.kneePole / elbowPole, CEREBRAX_STRIDE).
#   - The four sockets sit on the harness ring (radius ~0.39 round the
#     brain's axis, on the diagonals), so the legs splay like an X.
#   - THE BRAIN TURNS. It rides `skull` on the aim chain (chest -> neck ->
#     skull, motion.ts), and the neck's head is the brain's centre, so it
#     swivels in its ring like a turret to look at you; the ring and the legs
#     stay put.
#   - It PULSES: every lobe carries `morph=swell:`, driven by
#     MotionProfile.joystick.swell (joystick.ts joystickSwell: a slow breath)
#     with no joystick throw.
#
# SCALE. Every number below is AUTHORED; `scale` multiplies every length of
# the compiled body (body-scale.ts), and the kit and the detail generator are
# built on the COMPILED joints. Compiled: the ring at 1.50 m, the brain's
# centre at 1.86 m and 1.34 m across, the knees at 2.75 m, the feet on a
# 4.8 m diagonal. The brain's top stays under 2.5 m on purpose: the body
# normal map's region table stores positions in -2.5..2.5 m
# (body-normal.wgsl.ts pos16), so a taller body would lose its relief above it.
model cerebrax
  height 1.72
  # A boss: the brain alone is as wide as the player is tall. Eyeballed
  # against the arena's player (1.6 m eye line looks the face in the eye).
  scale 1.60

skeleton
  # The hips on the ring's back pair at y 0.94 (root 0.90 + len 0.04).
  root pelvis at 0.90 len=0.04
  # Level forward to the ring's front pair: the shoulder yoke.
  bone spine parent=pelvis dir=up pitch=90 len=0.50
  # Back and up to the brain's centre (0, 1.16, 0.25), the ring's centre axis.
  bone chest parent=spine  dir=up pitch=-48.65 len=0.333
  # The aim pivot: a short neck whose head is the brain's centre, so a turn
  # spins the brain about itself.
  bone neck  parent=chest  dir=up len=0.02
  bone skull parent=neck   dir=up len=0.30

  mirror
    # FRONT LEGS. The shoulder on the ring's front diagonal (0.30, 0.94, 0.50).
    bone clavicle parent=spine    dir=side len=0.30
    # Up and out to the knee cap (0.80, 1.72, 0.95): (0.50, 0.78, 0.45).
    bone upperarm parent=clavicle dir=up pitch=25.91 tilt=32.66 len=1.030
    # The long shin down to the ankle cap (1.08, 0.13, 1.30): (0.28, -1.59, 0.35).
    bone forearm  parent=upperarm dir=down pitch=12.23 tilt=9.99 len=1.652
    # The pointed foot, its tip on the floor.
    bone hand     parent=forearm  dir=down pitch=8 tilt=8 len=0.135
    # HIND LEGS: the same leg on the ring's back diagonal, raked back.
    bone thigh parent=pelvis side=0.30 dir=up pitch=-25.91 tilt=32.66 len=1.030
    bone shin  parent=thigh  dir=down pitch=-12.23 tilt=9.99 len=1.652
    bone foot  parent=shin   dir=down pitch=-8 tilt=8 len=0.135
  end

body
  # --- THE FRAME'S CORES: thin, hidden in the harness kit. ------------------
  # The gibbet's fuse rule: the validator joins clusters along STRAIGHT lines
  # between `core` prims, so the legs fuse to each other across a crossbar
  # at the hips and a yoke at the shoulders, and both bars run through the
  # bottom of the brain (the torso's core).
  bar  torso on spine from=0.00 to=1.00 r=0.040 blend=0.006 color=3a3e45 metal gloss=0.6
  bar  torso on pelvis from=1.00 to=1.00 offset=(-0.30,0,0) tip=(0.60,0,0) r=0.040 blend=0.006 color=3a3e45 metal gloss=0.6
  bar  torso on spine from=1.00 to=1.00 offset=(-0.30,0,0) tip=(0.60,0,0) r=0.040 blend=0.006 color=3a3e45 metal gloss=0.6

  # --- THE BRAIN: few prims, all `rigid` on the skull so it turns as one. ---
  # Its centre is the skull bone's head (the aim pivot). Semi-axes 0.42 wide,
  # 0.35 tall, 0.46 deep: longer than wide, a brain, not a ball.
  blob torso on skull at=0.00 r=0.400 wide=1.05 tall=0.86 deep=1.15 blend=0.040 core rigid morph=swell:*1.025
  # The two hemispheres, bulging up either side of the longitudinal fissure:
  # the valley between them on top is the fissure's shape (the map deepens it).
  blob torso on skull at=0.00 offset=(0.19,0.07,0.00) r=0.300 wide=0.80 tall=0.95 deep=1.40 blend=0.050 both rigid morph=swell:*1.04
  # Frontal lobes, swelling forward over the face like a brow.
  blob torso on skull at=0.00 offset=(0.15,0.02,0.27) r=0.200 wide=1.00 tall=1.00 deep=0.95 blend=0.050 both rigid morph=swell:*1.05
  # Temporal lobes, low on the sides, hanging over the ring.
  blob torso on skull at=0.00 offset=(0.30,-0.12,0.08) r=0.170 wide=0.85 tall=0.90 deep=1.50 blend=0.050 both rigid morph=swell:*1.05
  # The occipital lobes at the back.
  blob torso on skull at=0.00 offset=(0.12,0.00,-0.30) r=0.220 wide=1.00 tall=1.00 deep=0.95 blend=0.050 both rigid morph=swell:*1.04
  # The cerebellum tucked under the back, into the ring.
  blob torso on skull at=0.00 offset=(0.00,-0.22,-0.24) r=0.170 wide=1.50 tall=0.70 deep=1.00 blend=0.045 rigid morph=swell:*1.04

  # --- THE FACE: small, snarling, low on the front, pushed out of the brain
  # as if the brain had grown over a man's face and only this much shows. ---
  # The face's mass, a flattened mound under the frontal lobes.
  blob torso on skull at=0.00 offset=(0.00,-0.17,0.37) r=0.120 wide=1.25 tall=1.05 deep=0.70 blend=0.035 rigid
  # The brow: a heavy bar bowed down in the middle, a scowl.
  bar  torso on skull from=0 to=0 offset=(-0.095,-0.105,0.445) tip=(0.19,0,0) bend=(0,-0.03,0.02) r=0.026 blend=0.014 rigid
  # Sunken dark sockets under the brow; the kit's red embers sit in them.
  blob torso on skull at=0.00 offset=(0.045,-0.135,0.452) r=0.022 wide=1.30 tall=0.80 blend=0.006 color=1a0506 gloss=0.6 both rigid
  # Cheekbones, swept back from under the eyes.
  bar  torso on skull from=0 to=0 offset=(0.050,-0.170,0.450) tip=(0.060,0.010,-0.050) r=0.022 r2=0.014 blend=0.012 both rigid
  # A short broad nose, nostrils flared in the snarl.
  bar  torso on skull from=0 to=0 offset=(0.000,-0.135,0.470) tip=(0,-0.050,0.018) r=0.016 r2=0.024 blend=0.010 rigid
  # The snarl: a dark gullet recessed behind the lips (an additive mouth,
  # never a carve, the teratoma's lesson), the teeth are kit.
  blob torso on skull at=0.00 offset=(0.000,-0.232,0.440) r=0.030 wide=2.00 tall=0.90 deep=0.70 blend=0.006 color=1a0506 gloss=0.85 rigid
  # The upper lip, drawn up off the teeth; the lower lip and a small chin.
  bar  torso on skull from=0 to=0 offset=(-0.060,-0.212,0.455) tip=(0.12,0,0) bend=(0,0.014,0.016) r=0.012 blend=0.008 rigid
  bar  torso on skull from=0 to=0 offset=(-0.055,-0.258,0.445) tip=(0.11,0,0) bend=(0,-0.012,0.014) r=0.013 blend=0.008 rigid
  blob torso on skull at=0.00 offset=(0.000,-0.288,0.425) r=0.030 wide=1.30 tall=0.80 deep=0.80 blend=0.014 rigid

  # --- LEGS: machine only, thin cores INSIDE the kit (biomech-style.md: keep cores 2-3.5 cm or they show
  # through). Authored radii; compiled x1.60: the shin core 3.5 cm inside a 4.4-6 cm kit tube. The first pass at
  # 6.4 cm compiled was fatter than the kit's shin and rendered as a black rod. ---------------------------------
  bar  arm on clavicle from=0.00 to=1.00 r=0.030 blend=0.006 mirror core color=3a3e45 metal gloss=0.6
  blob arm on clavicle at=1.00 r=0.045 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  bar  arm on upperarm from=0.00 to=1.00 r=0.026 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  bar  arm on forearm  from=0.00 to=1.00 r=0.022 r2=0.018 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  bar  arm on hand     from=0.00 to=0.90 r=0.018 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  blob leg on thigh at=0.00 r=0.045 blend=0.006 mirror core color=3a3e45 metal gloss=0.6
  bar  leg on thigh from=0.00 to=1.00 r=0.026 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  bar  leg on shin  from=0.00 to=1.00 r=0.022 r2=0.018 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  bar  leg on foot  from=0.00 to=0.90 r=0.018 blend=0.006 mirror color=3a3e45 metal gloss=0.6

face
  # No generated face: the face is prims.
  headRadius 0.001
  headWidth  1.0
  headHeight 1.0
  headDepth  1.0
  jawWidth   1.0
  jawHeight  1.0
  jawDrop    0
  jawJut     0
  noseLength 0
  noseWidth  1.0
  noseDrop   0
  browHeavy  0
  browRise   0
  headBlend  0.006

palette
  # Raw brain: a pale wet pink, the sulci a bruised red-purple, a faint
  # yellow fatty mottle. Muted (the teratoma's lesson: painted colours read
  # more saturated than their hex).
  baseColor     0.70 0.45 0.44
  deepColor     0.40 0.08 0.12
  charColor     0.08 0.05 0.06
  specIntensity 0.80
  specRoughness 0.25
  fresnelBoost  0.60
  translucency  0.45
  wetness       0.80
  surfaceNoiseAmp    0.030
  silhouetteNoiseAmp 0.012
  mottleAmp     0.30
  mottleScale   1.4
  mottleColor   0.55 0.42 0.25
  grain         0.10

sheet
  # No face sheet (biomech-style.md: a non-person wears none).
  enabled 0
