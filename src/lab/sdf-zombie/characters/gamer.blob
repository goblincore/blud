# THE GAMER — the chair's BOSS variant (owner request, 2026-10-22: "a fleshy
# man fused into a gaming chair hooked into tubes and wires and VR headset
# maybe both hands on a fleshy joystick connected to his abdomen"). The
# chair's idea (chair.blob) taken to the encounter: a swollen, sedentary man
# grown into a racing-style gaming chair. A VR headset is fused over his eyes.
# IV lines, a feed hose and cables run from the chair into his arms, neck
# and spine. A joystick of flesh grows out of his navel; his hands are sawn
# off at the wrists and replaced by bone-metal prosthetic C-clamps closed
# round it. Videodrome on a castor base. Bigger than the chair (`scale`),
# so there is more of him to shoot through.
#
# THE RIG is the chair's, unchanged (read chair.blob's header): a short
# upright lumbar, the clavicles forward along the seat as his femurs, his
# shins as the front legs, the 'foreleg' waddle. What is new:
#   - HIS ARMS ARE NOT ON THE ARMRESTS: they reach in to the stick. His
#     upper arms are `rigid` on `chest`; the stick rides its own `hem` bone
#     with the prosthetic clamps (kit), and each forearm stretches from the
#     seat to the stick so its stump stays in its clamp's cuff (no arm IK
#     touches them: the rig's arms are the front legs).
#   - THE HEAD IS BLIND. The headset (kit, on `skull`) covers his eyes, so
#     there are no eye prims; the glow is the stick's fire button (down in
#     the orifice at its tip) and the headset's visor (kit).
#
# All numbers below are AUTHORED (the chair's size); `scale` multiplies every
# length of the compiled body, and the kit is built on the compiled joints.
model gamer
  height 2.10
  # A boss: 1.3x the chair. Eyeballed: his head clears a player's eye line
  # when he rears.
  scale 1.30

skeleton
  # The chair's skeleton (chair.blob explains each number).
  root pelvis at 0.47 len=0.06
  bone spine parent=pelvis dir=up pitch=3  len=0.19
  # He sits slumped further forward than the chair's sitter, toward the stick.
  bone chest parent=spine  dir=up pitch=8  len=0.36
  bone neck  parent=chest  dir=up pitch=30 len=0.11
  bone skull parent=neck   dir=up pitch=2  len=0.17
  # THE JOYSTICK's bone: the `hem` pendulum, from his hips up through the gut
  # to the middle of the grip (0, 0.898, 0.450), so the stick, the knob and
  # the clamps can move on their own: he jiggles it as he plays
  # (MotionProfile.joystick). An UPWARD hem: rig-bind.ts holds it stiffer than
  # cloth, so the stick does not droop or trail.
  bone hem   parent=pelvis dir=up pitch=50.72 len=0.5813

  mirror
    bone clavicle parent=spine    side=0.19 dir=down pitch=71 len=0.43
    bone upperarm parent=clavicle dir=down pitch=-14 tilt=6 len=0.30
    bone forearm  parent=upperarm dir=down pitch=16        len=0.22
    bone hand     parent=forearm  dir=down pitch=55        len=0.11
    bone thigh parent=pelvis side=0.21 dir=down pitch=22 tilt=8 len=0.21
    bone shin  parent=thigh  dir=down pitch=-30         len=0.23
    bone foot  parent=shin   dir=down pitch=8           len=0.14
  end

body
  # --- THE SEAT'S CORES (chair.blob's, for the same fuse paths). ------------
  bar  torso on spine from=0.00 to=1.00 r=0.050 blend=0.010 core
  bar  torso on pelvis from=1.00 to=1.00 offset=(-0.21,0,0) tip=(0.42,0,0) r=0.035 blend=0.006 color=3a3e45 metal gloss=0.6
  bar  torso on spine from=1.00 to=1.00 offset=(-0.19,0,0) tip=(0.38,0,0) r=0.035 blend=0.006 color=3a3e45 metal gloss=0.6

  # --- THE MAN: swollen, pasty, poured into the seat. -------------------------
  # His buttocks and hips spread to the seat's bolsters.
  blob torso on spine at=0.55 r=0.150 wide=1.30 tall=0.90 deep=1.00 offset=(0,0,0.010) blend=0.040
  # His lap, the thighs' roots (and the thighs' fuse path, as on the chair).
  blob torso on spine at=0.45 r=0.130 wide=1.60 tall=0.62 deep=1.15 offset=(0,-0.010,0.110) blend=0.035
  # THE GUT: a great soft belly sagging forward over his lap.
  # (First pass r 0.17 read as a stocky man, not a swollen one.)
  blob torso on chest at=0.15 r=0.190 wide=1.18 tall=0.95 deep=1.12 offset=(0,-0.030,0.110) blend=0.045
  blob torso on chest at=0.00 r=0.150 wide=1.25 tall=0.72 deep=1.05 offset=(0,-0.060,0.150) blend=0.045
  # Love handles spilling over the seat's bolsters.
  blob torso on chest at=0.05 r=0.085 wide=1.00 tall=0.80 deep=1.20 offset=(0.185,-0.040,0.050) blend=0.035 both
  # A roll of fat across the belly's top, under the chest.
  blob torso on chest at=0.38 r=0.120 wide=1.35 tall=0.45 deep=1.00 offset=(0,0,0.075) blend=0.030
  # The chest, soft and wide; the breasts sag.
  blob torso on chest at=0.58 r=0.150 wide=1.20 tall=1.00 deep=0.85 blend=0.035
  blob torso on chest at=0.62 r=0.070 wide=1.10 tall=0.95 deep=1.00 offset=(0.075,-0.035,0.085) blend=0.025 both
  # Shoulders sloping into a fat neck.
  blob torso on chest at=0.85 r=0.130 wide=1.45 tall=0.80 deep=0.80 blend=0.030
  blob torso on chest at=0.92 r=0.068 offset=(0.180,-0.020,-0.005) blend=0.025 both

  # --- HIS ARMS, IN TO THE STICK: `rigid` on the chest, see the header. ------
  # Generated from world targets (shoulder (0.20, 1.005, 0.04), elbow
  # (0.235, 0.80, 0.10), the old wrist (0.075, 0.865, 0.42)) as offsets from the
  # chest at 0.5 = (0, 0.898, 0.035). The elbows rest just over the kit's
  # armrest pads (top ~0.745).
  bar  torso on chest from=0.50 to=0.50 offset=(0.200,0.107,0.005) tip=(0.035,-0.205,0.060) r=0.060 r2=0.052 blend=0.014 rigid both
  blob torso on chest at=0.50 offset=(0.235,-0.098,0.065) r=0.052 blend=0.012 rigid both
  # THE FOREARMS end in SAWN STUMPS short of the stick (owner: his hands fused
  # into the grip were "problematic ... saw his wrists off to bloody stumps
  # and attach metal prosthetic c-clamp hands that go around the joystick").
  # Cut at 0.86 of the old elbow-to-wrist line, so a clear gap (~6 cm) runs to
  # the grip; the kit's prosthetics (make_gamer.py `clamps`, on `hem`) bridge it.
  # NOT rigid: each end binds to its nearest joint, the elbow to the seat's
  # clavicle head and the far end to the joystick's `hem` point, so the arms
  # stretch to follow the stick when he works it.
  bar  torso on chest from=0.50 to=0.50 offset=(0.2350,-0.0980,0.0650) tip=(-0.1280,0.0520,0.2560) r=0.048 r2=0.0416 blend=0.012 both
  # The WRIST, from inside the cuff to the cut: `rigid` on `hem`, so it and
  # the stump turn with the stick and the kit clamp (bound to the hem point
  # alone, the stump slid ~2 cm in its cuff when the stick tilted). The join
  # with the stretching forearm lies inside the cuff.
  bar  torso on hem from=1.00 to=1.00 offset=(0.1166,-0.0499,-0.1132) tip=(-0.0192,0.0078,0.0384) r=0.0421 r2=0.0411 blend=0.010 rigid both
  # The stump: the forearm's round end painted raw (a shell a hair proud of it
  # over the cut), a nub of bone in the middle and dark clots round it. The
  # kit's cuff runs on over most of it, so only a raw face shows in its lip:
  # left bare, the painted dome read as a glossy red ball.
  bar  torso on hem from=1.00 to=1.00 offset=(0.0974,-0.0421,-0.0748) tip=(-0.0009,0.0004,0.0018) r=0.0423 blend=0.002 color=5a1014 gloss=0.45 rigid both
  # RAGGED, not a clean cut (owner: the stumps were "a bit too clean"): torn
  # skin flaps and a rim of yellow fat round the edge, the two forearm bones
  # (radius and ulna) sticking out of the meat at different lengths, and dark
  # clots. Painted discs flattened along the cut face (deep 0.45) and melted
  # into the meat (blend 0.007): as round blobs they read as balls again.
  blob torso on hem at=1.00 offset=(0.0606,-0.0337,-0.0833) r=0.0133 wide=1.15 tall=1.0 deep=0.45 blend=0.007 color=7a1c22 gloss=0.8 rigid both
  blob torso on hem at=1.00 offset=(0.0767,-0.0072,-0.0786) r=0.0124 wide=1.15 tall=1.0 deep=0.45 blend=0.007 color=a87a70 gloss=0.7 rigid both
  blob torso on hem at=1.00 offset=(0.1166,-0.0113,-0.0556) r=0.0134 wide=1.15 tall=1.0 deep=0.45 blend=0.007 color=a88a60 gloss=0.6 rigid both
  blob torso on hem at=1.00 offset=(0.1197,-0.0512,-0.0414) r=0.0133 wide=1.15 tall=1.0 deep=0.45 blend=0.007 color=9a2a2e gloss=0.8 rigid both
  blob torso on hem at=1.00 offset=(0.0769,-0.0738,-0.0599) r=0.0113 wide=1.15 tall=1.0 deep=0.45 blend=0.007 color=8a3a36 gloss=0.8 rigid both
  # Splintered bone ends, jagged points standing out of the meat, and uneven
  # raw patches across the cut face (round bone nubs on a smooth dome read clean).
  bar  torso on hem from=1.00 to=1.00 offset=(0.0780,-0.0331,-0.0606) tip=(-0.0142,0.0043,0.0358) r=0.0085 r2=0.0025 blend=0.002 chamfer color=c8b890 gloss=0.3 rigid both
  bar  torso on hem from=1.00 to=1.00 offset=(0.0977,-0.0440,-0.0486) tip=(-0.0158,0.0031,0.0284) r=0.0085 r2=0.0025 blend=0.002 chamfer color=c8b890 gloss=0.3 rigid both
  blob torso on hem at=1.00 offset=(0.0617,-0.0421,-0.0497) r=0.0145 deep=0.40 blend=0.006 color=3e080a gloss=0.5 rigid both
  blob torso on hem at=1.00 offset=(0.0999,-0.0308,-0.0329) r=0.0115 deep=0.40 blend=0.006 color=7a1c22 gloss=0.5 rigid both
  blob torso on hem at=1.00 offset=(0.0894,-0.0431,-0.0356) r=0.0129 deep=0.40 blend=0.006 color=a0303a gloss=0.5 rigid both
  blob torso on hem at=1.00 offset=(0.0717,-0.0376,-0.0456) r=0.0145 deep=0.40 blend=0.006 color=4a0c10 gloss=0.5 rigid both

  # --- THE JOYSTICK: an infected, veiny flesh tube out of his navel, held in
  # his prosthetic clamps (kit). A SLIM grip (r 0.034 -> 0.027): a fat 4.4 cm
  # cone there once melted his old flesh hands into it ("way too fused"). The
  # grip stands at z 0.45, a hand's breadth clear of the gut's front (~0.34).
  # The stalk, ringed like a cord: ONE smooth quarter arc, out of his navel
  # level and curving up into the upright grip (a Bezier whose control point
  # sits at the corner, bend (0,-0.040,0.075)). It met the grip at a sharp
  # angle before (owner: "a bit too acute ... more gradual and curved").
  bar  torso on hem from=1.00 to=1.00 offset=(0.000,-0.163,-0.150) tip=(0.000,0.080,0.150) r=0.042 r2=0.030 bend=(0,-0.040,0.075) blend=0.020 rigid
  blob torso on hem at=1.00 offset=(0.000,-0.150,-0.054) r=0.037 wide=1.15 tall=1.15 deep=1.15 blend=0.012 rigid
  blob torso on hem at=1.00 offset=(0.000,-0.132,-0.022) r=0.035 wide=1.15 tall=1.15 deep=1.15 blend=0.012 rigid
  blob torso on hem at=1.00 offset=(0.000,-0.107,-0.004) r=0.033 wide=1.15 tall=1.15 deep=1.15 blend=0.012 rigid
  # THE BEND SAGS: pendulous lumps of skin hanging under the stalk's curve,
  # off-centre and uneven (owner: "make the bottom rounded part of the
  # joystick ... more irregular and wrinkly looking, sagging"); its wrinkles
  # and folds are baked (gamer.detail).
  blob torso on hem at=1.00 offset=(0.0120,-0.1820,-0.0580) r=0.030 tall=1.30 deep=0.90 blend=0.014 rigid
  blob torso on hem at=1.00 offset=(-0.0160,-0.1740,-0.0260) r=0.026 tall=1.25 deep=0.95 blend=0.014 rigid
  blob torso on hem at=1.00 offset=(0.0060,-0.1560,0.0020) r=0.021 tall=1.20 blend=0.014 rigid
  # The grip, upright between the clamps, narrowing to a neck above them.
  bar  torso on hem from=1.00 to=1.00 offset=(0.000,-0.083,-0.000) tip=(0.000,0.123,0.000) r=0.034 r2=0.027 blend=0.012 rigid
  # THE KNOB: a swollen bulb on the neck, wider than the grip, above the
  # clamps. Its BULK keeps the stick's top distinct (owner: a slim pointed tip
  # was "less distinct than it was originally").
  blob torso on hem at=1.00 offset=(0.000,0.062,-0.000) r=0.040 tall=0.85 blend=0.010 morph=swell:(0,0.004,0)*(1.22,1.18,1.22) rigid
  # THE KNOB BREATHES (owner: "it breathes and grows, like the bulbous part
  # enlarges and the rocket inside is exposed a bit more"): on the `swell`
  # channel (MotionProfile.joystick.swell drives it, joystick.ts) the knob
  # grows ~20% and rises 4 mm, its lip rises 1 cm and the whole rocket 2 cm,
  # so ~1 cm more of the nose clears the lip at full swell.
  # THE NOSE: a rounded bullet sunk deep in the knob's crown, only its domed
  # tip showing (~1.6 cm proud of the knob's top at y 0.096), like a rocket in
  # its silo about to launch (owner: "sits slightly inside the top part of the
  # joystick ... more rounded", then "sink in more ... basically just the tip
  # showing"). A capsule's end is a hemisphere, which is the dome.
  bar  torso on hem from=1.00 to=1.00 offset=(0.000,0.058,0.000) tip=(0.000,0.039,0.000) r=0.020 r2=0.015 blend=0.004 morph=swell:(0,0.020,0) rigid
  # A swollen lip of SKIN round it where it comes out of the knob: unpainted,
  # so it keeps the skin's mottle and takes the baked relief (painted raw red
  # it read as a plastic collar).
  blob torso on hem at=1.00 offset=(0.000,0.094,0.000) r=0.024 wide=1.0 tall=0.42 blend=0.006 morph=swell:(0,0.010,0)*(1.18,1,1.18) rigid
  # THE PINK, on the tip alone: one shell a hair out of the bullet's surface
  # from just under the lip to its top, so its round cap paints the dome.
  bar  torso on hem from=1.00 to=1.00 offset=(0.000,0.090,0.000) tip=(0.000,0.007,0.000) r=0.0171 r2=0.0162 blend=0.002 color=cc8a98 gloss=0.6 morph=swell:(0,0.020,0) rigid
  # THE ORIFICE in the dome, where the fire button was: a dark wet hole with
  # the lit button nub down inside it. Its infected crust, the stick's veins
  # and the veins over his knuckles are BAKED (gamer.detail): as prims they
  # read as "tubes and skittles" (owner).
  blob torso on hem at=1.00 offset=(0.000,0.110,0.000) r=0.0055 tall=0.70 blend=0.001 color=1a0406 gloss=0.95 morph=swell:(0,0.020,0) rigid
  blob torso on hem at=1.00 offset=(0.000,0.1125,0.000) r=0.0034 blend=0.001 color=ff2a1c glow=0.8 gloss=0.9 morph=swell:(0,0.020,0) rigid

  # --- HIS NECK AND HEAD. -----------------------------------------------------
  # A thick neck, all fat.
  bar  torso on neck from=0.00 to=1.00 r=0.075 r2=0.066 blend=0.025 core
  bar  head on neck from=0.30 to=1.00 r=0.050 blend=0.012 core
  # Jowls: a double chin hanging under the jaw.
  blob head on skull at=0.10 r=0.062 wide=1.45 tall=0.70 deep=1.00 offset=(0,-0.030,0.060) blend=0.020

  # --- HIS THIGHS: the seat's side rails, swollen. ---------------------------
  bar  arm on clavicle from=0.00 to=0.92 r=0.085 r2=0.070 tall=0.80 blend=0.025 mirror core
  blob arm on clavicle at=1.00 r=0.068 offset=(0,0,0.010) blend=0.018 mirror
  # --- HIS CALVES: the tops of the front legs, fat. ---------------------------
  bar  arm on upperarm from=0.05 to=0.95 r=0.060 r2=0.040 blend=0.015 mirror
  # --- HIS FEET inside the greaves (chair.blob). ------------------------------
  bar  arm on forearm from=0.00 to=0.85 r=0.034 r2=0.024 blend=0.010 mirror
  bar  arm on hand    from=0.00 to=0.90 r=0.018 blend=0.006 mirror color=3a3e45 metal gloss=0.6

  # --- THE BACK LEGS: machine only. -------------------------------------------
  blob leg on thigh at=0.00 r=0.040 blend=0.006 mirror core color=3a3e45 metal gloss=0.6
  bar  leg on thigh from=0.00 to=1.00 r=0.025 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  bar  leg on shin  from=0.00 to=1.00 r=0.022 blend=0.006 mirror color=3a3e45 metal gloss=0.6
  bar  leg on foot  from=0.00 to=0.90 r=0.018 blend=0.006 mirror color=3a3e45 metal gloss=0.6

face
  # The generated face, made fat: wide jaw, heavy cheeks. The headset covers
  # the eyes and brow; the slack mouth and jowls show under it.
  headRadius 0.112
  headWidth  0.86
  headHeight 1.10
  headDepth  0.92
  jawWidth   0.88
  jawHeight  0.90
  jawDrop    0.110
  jawJut     0.03
  noseLength 0.012
  noseWidth  0.42
  noseDrop   0.010
  browHeavy  0.006
  browRise   0.040

palette
  # Pasty, sweating, blotched red where the tubes go in.
  baseColor     0.76 0.60 0.54
  deepColor     0.50 0.14 0.14
  charColor     0.08 0.05 0.06
  specIntensity 0.70
  specRoughness 0.26
  fresnelBoost  0.60
  translucency  0.40
  wetness       0.70
  surfaceNoiseAmp    0.030
  silhouetteNoiseAmp 0.010
  mottleAmp     0.32
  mottleScale   1.2
  mottleColor   0.62 0.30 0.30
  grain         0.10
