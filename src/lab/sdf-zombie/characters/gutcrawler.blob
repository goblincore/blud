  bar  head on skull from=0.2 to=0.2 offset=(-0.0130,0.0014,0.1342) tip=(-0.0165,0.0000,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0295,0.0014,0.1422) tip=(-0.0135,0.0000,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0125,0.0051,0.1342) tip=(-0.0156,0.0046,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0281,0.0096,0.1422) tip=(-0.0128,0.0038,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0109,0.0084,0.1342) tip=(-0.0131,0.0084,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0241,0.0169,0.1422) tip=(-0.0108,0.0069,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0085,0.0112,0.1342) tip=(-0.0096,0.0110,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0181,0.0223,0.1422) tip=(-0.0078,0.0090,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0054,0.0132,0.1342) tip=(-0.0055,0.0121,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0109,0.0253,0.1422) tip=(-0.0045,0.0099,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0019,0.0143,0.1342) tip=(-0.0017,0.0117,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(-0.0035,0.0259,0.1422) tip=(-0.0014,0.0095,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  blob head on skull at=0.2 offset=(-0.0070,0.0014,0.1462) r=0.0055 blend=0.002 color=200608 gloss=0.95
  blob head on skull at=0.2 offset=(0.0070,0.0014,0.1462) r=0.0055 blend=0.002 color=200608 gloss=0.95
  # Loose skin: a dewlap hanging under the throat.
  blob head on neck at=0.55 r=0.045 wide=1.1 tall=0.8 deep=1.3 offset=(0,-0.040,0) blend=0.020

  # --- ARMS: a man's, ~25% fuller than the first pass (owner: "too thin"); a
  # knotted biceps, the forearm thickening toward the elbow.
  blob arm on clavicle at=1.00 r=0.062 blend=0.016 mirror core
  bar  arm on upperarm from=0.00 to=0.95 r=0.058 r2=0.043 blend=0.013 mirror
  blob arm on upperarm at=0.40 r=0.044 tall=1.50 offset=(0,0.012,0) blend=0.013 mirror
  blob arm on forearm at=0.00 r=0.042 blend=0.009 mirror
  bar  arm on forearm from=0.05 to=0.95 r=0.042 r2=0.028 blend=0.011 mirror
  # BALL HANDS, the cast's own (owner, 2026-10-23: "that's the way hands are
  # in this universe"): a round fist on the end of each forearm, planted on
  # the floor like a stump.
  blob arm on hand at=0.30 r=0.048 wide=1.05 tall=0.95 deep=1.05 offset=(0,0.014,0) blend=0.012 mirror


face
  # A human head, the female's generated proportions (female.blob), with the
  # generated jaw made small (0.55 x 0.40: the chin prim and the snout fill the
  # lower face) and no nose (the snout is where it was).
  headRadius 0.070
  headWidth  0.92
  headHeight 1.25
  headDepth  1.10
  jawWidth   0.55
  jawHeight  0.40
  jawDrop    0.060
  jawJut     0.030
  noseLength 0.001
  noseWidth  0.633
  noseDrop   0.022
  browHeavy  0.004
  browRise   0.022
  headBlend  0.005

palette
  # A naked mole-rat's hide: pink, hairless, thin enough to see the blood
  # under it (high translucency), wet, mottled violet where the veins run.
  baseColor     0.70 0.48 0.44
  deepColor     0.45 0.12 0.14
  charColor     0.08 0.05 0.05
  specIntensity 0.60
  specRoughness 0.35
  fresnelBoost  0.60
  translucency  0.45
  wetness       0.55
  surfaceNoiseAmp    0.020
  silhouetteNoiseAmp 0.008
  mottleAmp     0.35
  mottleScale   3.0
  mottleColor   0.50 0.32 0.40
  grain         0.10

# The face: gutcrawler-face.png, made from female-face.png (desaturated toward
# a mole-rat's pink, the hair painted out to a bald wrinkled scalp, the eyes
# squeezed to wet slits between puffy lids, the mouth painted out under the
# snout). Multiplied (decal 0) so it takes the body's light. projScaleY 0.27 /
# projCentreY 0.436 (the female's are 0.23 / 0.45): squeezed a little so the
# face's lower half lands on this head's short lower face, eyes where they were.
sheet
  image       gutcrawler-face.png
  decal       0
  projScaleX  0.19
  projScaleY  0.27
  projCentreX 0.50
  projCentreY 0.436
  # No glint: the eyes are slits.
  eyeGlowAmp  0
  eyeGlowCut  0.69
