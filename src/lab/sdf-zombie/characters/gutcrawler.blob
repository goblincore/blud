# THE GUTCRAWLER — a giant naked grub with a man's chest, arms and head on the
# front, hauling itself along the floor on its arms. Brief (2026-10-22): a
# legless crawler after the Dead Space crawlers, "a human head on a wretched,
# writhing human body made to bend in ways it is not meant to". Reached by the
# owner's reviews, in order (2026-10-23): a lizard-man ("like a lizard and a
# snake meets a hominid ... not creepy") -> a belly-up man with the head hanging
# upside down -> "bigger, like a fat worm / giant maggot" -> head and neck
# "semi normal" -> "like a naked mole" -> a star-nosed mole's tube snout in place
# of the mouth. So: a pink, hairless, wrinkled grub (the wrinkles are the baked
# normal map, gutcrawler.detail), a man's front stuck on it, a human face with
# the eyes squeezed to slits (gutcrawler-face.png), and a star of 22 pink rays
# where the mouth should be. Ball fists, like the rest of the cast. No kit: the
# design left the biomech machinery behind on the way.
#
# THE RIG, on the biped names like the gorehound (biomech-style.md):
#   - the arms are 'foreleg's (gait.ts CRAWL_DRAG): each reaches ahead, plants,
#     and hauls the body past it while the other reaches (forePhase 0: the L/R
#     clocks, half a stride apart), the elbows poled up and out (elbowPole),
#     the chest rolling onto the hauling arm (crawlRoll);
#   - NO LEGS. actor.ts masks "missing" limbs by the limbs the body was built
#     with: a body that never had legs is not one that lost them (until then
#     collapse.ts dropped this one flat every frame);
#   - the rear of the grub rides a CHAIN of pendulums: `hem` then `hem2` and
#     `hem3` chained off it (gait.ts GaitJointName 'hem2'). The gait's body
#     wave (undulate) runs from the shoulders down the chain, so the rings
#     writhe as it hauls. The chain's tip stays ABOVE the fists (bindRig pins
#     the lowest rig point).
#   - it attacks by REARING its front half off the floor and SLAMMING it down
#     on you, snout first (hound-attack.ts 'slam').
model gutcrawler
  height 0.55

skeleton
  # The grub lies on its belly: its fattest ring (r 0.285 x tall 0.86) has its
  # centre at the hips, (0, 0.26, 0), so its underside sits on the floor.
  root pelvis at 0.22 len=0.04
  # The man's front: the spine runs level forward to the withers, which the
  # arms hold up, then the chest rises to the throat and the neck lifts the
  # head upright to stare ahead:
  #   spine -> withers (0, 0.25, 0.41)
  #   chest -> neck base (0, 0.31, 0.61)
  #   neck  -> the base of the skull (0, 0.41, 0.75), skull upright above it
  bone spine parent=pelvis dir=up pitch=91.8 len=0.411
  bone chest parent=spine  dir=up pitch=72 len=0.21
  bone neck  parent=chest  dir=up pitch=55 len=0.17
  bone skull parent=neck   dir=up pitch=8 len=0.21
  # The REAR of the grub: back along the floor from the hips in three
  # pendulum segments, sloping down as the rings taper. The gait's body wave
  # (CRAWL_DRAG undulate) swings each segment wider and later.
  bone hem   parent=pelvis dir=up pitch=-95 len=0.40
  bone hem2 parent=hem    dir=up pitch=-101 len=0.38
  bone hem3 parent=hem2  dir=up pitch=-104 len=0.32

  mirror
    # Shoulders off the withers, then the crawling arm. The first pass ran the
    # humerus level and forward and planted the hand ahead of the face, so the
    # arm was nearly straight at rest: in the walk the hands planted at full
    # stretch and the elbows never bent (a glide, not a drag). Now the arm is a
    # man pulling himself along the floor: the humerus goes OUT, forward and UP
    # to an elbow above and outboard of the shoulder, (0.38, 0.33, 0.60);
    # the long forearm drops to a wrist planted beside the face, (0.31, 0.05,
    # 0.78); the hand bone (the ball fist rides it) points forward-out. Shoulder-to-wrist at
    # rest is 0.43 m on a 0.64 m chain (67%): room to reach well ahead and to
    # fold deep at the end of each haul. Angles solved from those points
    # (dirVector: `up` for the rising humerus, `down` for the rest).
    bone clavicle parent=spine    dir=side tilt=-8 len=0.17
    bone upperarm parent=clavicle dir=up   pitch=38.57 tilt=63.43 len=0.30
    bone forearm  parent=upperarm dir=down pitch=31.95 tilt=-14.04 len=0.34
    bone hand     parent=forearm  dir=down pitch=69.76 tilt=35.54 len=0.15
  end

body
  # THE MAGGOT (owner, 2026-10-23: "bigger, like a fat worm / giant maggot").
  # A man's chest, arms and hanging head on the front of a swollen grub body:
  # eleven fat RING segments, short along the body (deep 0.62) with tight
  # blends so the creases between them pinch in, swelling just behind the
  # ribs and tapering to a blunt rear. The rear rings ride the hem -> hem2 ->
  # hem3 pendulums, so the gait's body wave writhes them. Each ring's
  # underside sits on the floor (centre height ~ r x tall).
  blob torso on spine  at=0.681 r=0.230 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on spine  at=0.292 r=0.265 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem    at=0.101 r=0.285 wide=1.12 tall=0.86 deep=0.62 blend=0.022 core
  blob torso on hem    at=0.477 r=0.285 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem    at=0.854 r=0.270 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem2  at=0.247 r=0.245 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem2  at=0.622 r=0.215 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem2  at=0.971 r=0.180 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem3  at=0.350 r=0.145 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem3  at=0.672 r=0.110 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  blob torso on hem3  at=0.929 r=0.075 wide=1.12 tall=0.86 deep=0.62 blend=0.022
  # Skin sagging off the lower flanks of the fattest rings, a mole-rat's
  # loose hide pooling on the floor.
  blob torso on hem    at=0.101 r=0.120 wide=0.70 tall=0.55 deep=1.60 offset=(0.250,-0.140,0) blend=0.040 both
  blob torso on hem    at=0.600 r=0.110 wide=0.70 tall=0.55 deep=1.60 offset=(0.235,-0.130,0) blend=0.040 both
  blob torso on spine  at=0.400 r=0.100 wide=0.70 tall=0.55 deep=1.50 offset=(0.215,-0.120,0) blend=0.040 both
  # The man's front on the grub: a ribcage, the sternum a ridge down its
  # middle, the costal arch flaring over the first ring.
  blob torso on spine at=0.78 r=0.150 wide=1.25 tall=0.85 deep=1.10 offset=(0,0.020,0) blend=0.028
  bar  torso on spine from=0.62 to=1.00 r=0.022 offset=(0,0.135,0) blend=0.018
  bar  torso on spine from=0.55 to=0.80 r=0.030 offset=(0.090,0.090,0.02) tip=(0.04,-0.03,-0.05) blend=0.016 both
  # The pectorals and the collarbones, the shoulders rolled back under it.
  blob torso on spine at=0.93 r=0.075 wide=1.10 tall=0.55 deep=1.00 offset=(0.075,0.075,0.01) blend=0.018 both
  blob torso on spine at=0.98 r=0.075 offset=(0.130,-0.005,0) blend=0.022 both
  # The throat, rising to the neck.
  bar  torso on chest from=0.10 to=1.00 r=0.074 wide=1.10 tall=0.90 blend=0.022
  # THE NECK: plain flesh (owner, 2026-10-23: the spine-through-the-crown
  # join did not read; "make the head and neck semi normal"). The fear is in
  # the face and the snout.
  bar  head on neck from=0.00 to=1.00 r=0.052 r2=0.046 blend=0.016 core
  blob head on neck at=0.45 r=0.015 offset=(0,0,0) blend=0.006

  # --- HEAD: a human head (the face block's generated cranium and chin; its
  # nose is shrunk away under the snout) wearing a baked human face.

  # THE FACE IS THE PAINTING (gutcrawler-face.png, from female-face.png):
  # the eyes squeezed to slits in it, so no prim fights them.

  # THE TUBE SNOUT (owner, 2026-10-23: a star-nosed mole's snout in place
  # of the mouth; "we don't need him to open his mouth"). A fleshy tube
  # pushes out of the middle of the face and ends in a ring of 22 pink rays
  # round two nostrils. It never opens: no jaw bone, the face's chin is part
  # of the skull. Rays: 11 a side, longest at the sides, each a fleshy finger
  # in two pieces, tapering to a blunt tip and curling forward, with gaps
  # between them (the first pass, packed and flat, read as a flower).
  blob head on skull at=0.2 offset=(0.0000,-0.0586,0.0592) r=0.034 blend=0.01 wide=1.00 tall=0.75 deep=0.95
  bar  head on skull from=0.2 to=0.2 offset=(0.0000,0.0044,0.0742) tip=(0.0000,-0.0020,0.0450) r=0.026 r2=0.022 blend=0.01
  bar  head on skull from=0.2 to=0.2 offset=(0.0000,-0.0106,0.0792) tip=(0.0000,0.0060,0.0370) r=0.02 r2=0.018 blend=0.008
  blob head on skull at=0.2 offset=(0.0000,0.0014,0.1322) r=0.02 blend=0.006 deep=0.55 color=d88a86 gloss=0.8
  bar  head on skull from=0.2 to=0.2 offset=(0.0019,0.0143,0.1342) tip=(0.0017,0.0117,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0035,0.0259,0.1422) tip=(0.0014,0.0095,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0054,0.0132,0.1342) tip=(0.0055,0.0121,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0109,0.0253,0.1422) tip=(0.0045,0.0099,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0085,0.0112,0.1342) tip=(0.0096,0.0110,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0181,0.0223,0.1422) tip=(0.0078,0.0090,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0109,0.0084,0.1342) tip=(0.0131,0.0084,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0241,0.0169,0.1422) tip=(0.0108,0.0069,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0125,0.0051,0.1342) tip=(0.0156,0.0046,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0281,0.0096,0.1422) tip=(0.0128,0.0038,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0130,0.0014,0.1342) tip=(0.0165,0.0000,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0295,0.0014,0.1422) tip=(0.0135,0.0000,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0125,-0.0023,0.1342) tip=(0.0156,-0.0046,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0281,-0.0068,0.1422) tip=(0.0128,-0.0038,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0109,-0.0056,0.1342) tip=(0.0131,-0.0084,0.0080) r=0.0062 r2=0.0055 blend=0.0015 color=e8a49c gloss=0.75
  bar  head on skull from=0.2 to=0.2 offset=(0.0241,-0.0141,0.1422) tip=(0.0108,-0.0069,0.0140) r=0.0055 r2=0.004 blend=0.0015 color=e8a49c gloss=0.75
