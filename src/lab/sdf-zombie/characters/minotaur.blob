# ============================================================================
# minotaur — FIRST-DRAFT .blob generated from the reference mesh's vertex
# clouds. Every number is measured; its line's `# fit:` comment names the
# source. Bone axes are cloud medial lines, never rig joints (they sit 9-13
# cm off the skin); bands split at radial-profile inflections; radii are band
# medians; angles exist only where dirVector is invertible.
#
# NOT attempted — not derivable from a Meshy reference; add by hand:
#   fingers (the rig lumps each hand into one joint), bend= on any bone,
#   angles on side/fwd bones, mottle colour, jaw/nose/brow shaping.
#
# Budget: 67/80 prims (63 authored + 4 face),
# worst cluster armL at 16/40. The shader's hard ceilings are
# 128 prims total — which derived wound bones SHARE — and 64 per cluster,
# where the fold SILENTLY stops; half of each is left for refinement.
# TRIMMED 25 least-evidenced band(s) to stay inside. Re-run the draft after
# refining so any cut you undo is re-measured, not silently restored.
#
# Hand pass owed:
#   pelvis: cloud residual 0.1478 m RMS about its axis — wants a bend=
#   chest: cloud residual 0.0321 m RMS about its axis — wants a bend=
#   skull: cloud residual 0.0905 m RMS about its axis — wants a bend=
#   clavicle: cloud residual 0.0998 m RMS about its axis — wants a bend=
#   upperarm: cloud residual 0.0834 m RMS about its axis — wants a bend=
#   forearm: cloud residual 0.0652 m RMS about its axis — wants a bend=
#   hand: cloud residual 0.0548 m RMS about its axis — wants a bend=
#   thigh: cloud residual 0.1174 m RMS about its axis — wants a bend=
#   shin: cloud residual 0.1026 m RMS about its axis — wants a bend=
#   foot: cloud residual 0.0918 m RMS about its axis — wants a bend=
#   pelvis band 1: rotated cross-section — the axes cannot say it
#   pelvis band 1: paint splits mid-band — colour boundary owed
#   pelvis band 2: rotated cross-section — the axes cannot say it
#   pelvis band 2: paint splits mid-band — colour boundary owed
#   chest band 1: rotated cross-section — the axes cannot say it
#   chest band 1: paint splits mid-band — colour boundary owed
#   chest band 9: rotated cross-section — the axes cannot say it
#   skull band 1: rotated cross-section — the axes cannot say it
#   skull band 1: paint splits mid-band — colour boundary owed
#   skull band 3: rotated cross-section — the axes cannot say it
#   skull band 3: paint splits mid-band — colour boundary owed
#   skull band 4: rotated cross-section — the axes cannot say it
#   skull band 4: paint splits mid-band — colour boundary owed
#   skull band 5: paint splits mid-band — colour boundary owed
#   skull band 8: rotated cross-section — the axes cannot say it
#   clavicle band 1: rotated cross-section — the axes cannot say it
#   clavicle band 1: paint splits mid-band — colour boundary owed
#   clavicle band 2: rotated cross-section — the axes cannot say it
#   clavicle band 2: paint splits mid-band — colour boundary owed
#   clavicle band 3: rotated cross-section — the axes cannot say it
#   clavicle band 3: paint splits mid-band — colour boundary owed
#   clavicle band 4: rotated cross-section — the axes cannot say it
#   clavicle band 4: paint splits mid-band — colour boundary owed
#   clavicle band 10: rotated cross-section — the axes cannot say it
#   clavicle band 10: paint splits mid-band — colour boundary owed
#   upperarm band 1: rotated cross-section — the axes cannot say it
#   upperarm band 1: paint splits mid-band — colour boundary owed
#   upperarm band 2: rotated cross-section — the axes cannot say it
#   upperarm band 2: paint splits mid-band — colour boundary owed
#   upperarm band 3: rotated cross-section — the axes cannot say it
#   upperarm band 3: paint splits mid-band — colour boundary owed
#   forearm band 1: rotated cross-section — the axes cannot say it
#   forearm band 1: paint splits mid-band — colour boundary owed
#   forearm band 2: rotated cross-section — the axes cannot say it
#   forearm band 2: paint splits mid-band — colour boundary owed
#   forearm band 3: rotated cross-section — the axes cannot say it
#   forearm band 3: paint splits mid-band — colour boundary owed
#   hand band 1: paint splits mid-band — colour boundary owed
#   hand band 4: rotated cross-section — the axes cannot say it
#   hand band 4: paint splits mid-band — colour boundary owed
#   hand band 8: paint splits mid-band — colour boundary owed
#   hand band 9: paint splits mid-band — colour boundary owed
#   hand band 12: rotated cross-section — the axes cannot say it
#   hand band 12: paint splits mid-band — colour boundary owed
#   thigh band 1: paint splits mid-band — colour boundary owed
#   thigh band 2: rotated cross-section — the axes cannot say it
#   thigh band 2: paint splits mid-band — colour boundary owed
#   thigh band 4: rotated cross-section — the axes cannot say it
#   thigh band 4: paint splits mid-band — colour boundary owed
#   shin.l band 1: paint splits mid-band — colour boundary owed
#   shin.l band 2: rotated cross-section — the axes cannot say it
#   shin.l band 3: rotated cross-section — the axes cannot say it
#   shin.l band 3: paint splits mid-band — colour boundary owed
#   shin.l band 5: rotated cross-section — the axes cannot say it
#   shin.r band 1: rotated cross-section — the axes cannot say it
#   shin.r band 1: paint splits mid-band — colour boundary owed
#   shin.r band 2: rotated cross-section — the axes cannot say it
#   shin.r band 2: paint splits mid-band — colour boundary owed
#   shin.r band 3: rotated cross-section — the axes cannot say it
#   foot band 1: rotated cross-section — the axes cannot say it
#   foot band 1: paint splits mid-band — colour boundary owed
#   foot band 2: rotated cross-section — the axes cannot say it
#   foot band 2: paint splits mid-band — colour boundary owed
#
# Then bake the face:  # run: npm run blob:face-bake -- minotaur
# Refine with npm run blob:rings -- minotaur; judge with blob:measure and
# npm run blob:depth -- minotaur (the instrument that sees inside the outline).
# ============================================================================

model minotaur
  height 1.2168  # fit: requested authored height
  stance humanoid  # fit: knee 0.0681 m forward of the hip-ankle line

skeleton
  root pelvis at 0.5809 len=0.2117  # fit: medial axis of the pelvis cloud, extent 0.2117 m
  bone chest parent=pelvis dir=up pitch=2.52 len=0.0784  # fit: medial axis of the chest cloud, extent 0.0784 m, residual 0.0321 RMS; dir err 0°
  bone spine2 parent=chest dir=up pitch=2.52 len=0.0171  # fit: medial axis of the spine2 cloud, extent 0.0171 m, residual 0.0079 RMS; dir err 0°
  bone skull parent=spine2 dir=up pitch=2.52 len=0.2307  # fit: medial axis of the skull cloud, extent 0.2307 m, residual 0.0905 RMS; dir err 0°
  mirror
    bone clavicle parent=spine2 side=0.1598 dir=side len=0.2168  # fit: medial axis of the clavicle cloud, extent 0.2168 m, residual 0.0998 RMS; angles not expressible on a side base — the bare base errs 2.8439°
    bone upperarm parent=clavicle side=0.109 dir=side len=0.2705  # fit: medial axis of the upperarm cloud, extent 0.2705 m, residual 0.0834 RMS; angles not expressible on a side base — the bare base errs 22.1209°
    bone forearm parent=upperarm side=0.0384 dir=side len=0.2558  # fit: medial axis of the forearm cloud, extent 0.2558 m, residual 0.0652 RMS; angles not expressible on a side base — the bare base errs 2.6189°
    bone hand parent=forearm side=0.0133 dir=side len=0.2241  # fit: medial axis of the hand cloud, extent 0.2241 m, residual 0.0548 RMS; angles not expressible on a side base — the bare base errs 25.0511°
    bone thigh parent=pelvis side=0.1413 dir=down pitch=5.7886 tilt=14.9106 len=0.3187  # fit: medial axis of the thigh cloud, extent 0.3187 m, residual 0.1174 RMS; dir err 0°
    bone shin parent=thigh side=0.0195 dir=up pitch=-77.0734 tilt=-58.9307 len=0.3694  # fit: medial axis of the shin cloud, extent 0.3694 m, residual 0.1026 RMS; dir err 0°; pair NOT mirrored (asym 0.6271) — prims emitted per side
    bone foot parent=shin side=0.0931 dir=down pitch=36.1567 tilt=3.2839 len=0.2672  # fit: medial axis of the foot cloud, extent 0.2672 m, residual 0.0918 RMS; dir err 0°
  end

