face
  headRadius 0.1006  # fit: median radial distance of the Head cloud (7354 verts)
  headWidth 1.194  # fit: p98 half-extent along world x / median radius
  headHeight 1.2256  # fit: p98 half-extent along world y / median radius
  headDepth 1.5357  # fit: p98 half-extent along world z / median radius

# run: npm run blob:face-bake -- minotaur
sheet
  image minotaur-face.png  # fit: pre-wired — the bake writes this file
  decal 1  # fit: pre-wired — pastes the baked sheet onto the cranium

palette
  baseColor 0.0906 0.0514 0.0302  # fit: mean texel colour of 114285 samples (sRGB 85,64,49)
  mottleAmp 0.2618  # fit: texel spread RMS 52.36 over 114285 samples
