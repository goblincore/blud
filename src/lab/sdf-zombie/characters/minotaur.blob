#
# Then bake the face:  # run: npm run blob:face-bake -- minotaur
# Refine with npm run blob:rings -- minotaur; judge with blob:measure and
# npm run blob:depth -- minotaur (the instrument that sees inside the outline).
# ============================================================================

model minotaur
  height 1.2168  # fit: requested authored height
  stance humanoid  # fit: knee 0.061 m forward of the hip-ankle line

