# Mouse kit — the POLYGON half of the mouse, authored in WAM.
#
# WHY TWO LANGUAGES FOR ONE CHARACTER. .blob builds flesh out of blended
# signed-distance primitives, and smooth-min rounds every edge it touches, so
# a tee's hem, a brow slab's crease or a shoe sole is either smeared or has
# to be fought back with `hard` blends. WAM is a text→glTF mesh compiler,
# which is the other half of that trade. Flesh in .blob, clothes in .wam —
# same bargain as goblin-kit.wam, whose header says it in full.
#
# THE SKELETON BELOW MIRRORS characters/mouse.blob AND MUST TRACK IT. Two
# conversions apply and neither is optional (see goblin-kit.wam for the full
# versions):
#
#   * UNITS. WAM lengths are fractions of `height`; .blob's are metres. Every
#     number here is the .blob metre value / 1.10.
#   * PITCH SIGN ON `down` BONES. WAM's pitch tips an `up` bone forward and a
#     `down` bone BACKWARD; .blob's always carries toward +z. So `up` bones
#     (spine1, chest, neck, skull) share their pitch verbatim, and every
#     `down` bone (upperarm, forearm, thigh, shin) has it NEGATED.
#     .blob's arms: upperarm pitch=-2, forearm pitch=2, hand pitchless.
#     .blob's legs: thigh pitch=8, shin pitch=-9. `tilt` needs no flip.
#
# RING SIZES ARE MEASURED, NOT EYEBALLED — marched off the .blob field
# (see the numbers scattered through this file), in metres there / 1.10 here.
# Measured flesh, for reference:
#   torso y0.30 w=0.146 d=0.180   y0.36 w=0.130 d=0.159   y0.42 w~0.130 d=0.109
#   y0.48 w~0.128 d=0.116  y0.51 w=0.109 d=0.099  y0.54 w=0.080 d=0.080
#   arm  0.051 dia at the forearm, 0.044 at the wrist
#   leg  0.058..0.067 wide, 0.056 deep at the knee..ankle
#   ankle joint centre y 0.162, flesh sole 0.138 — the shoe bridges to 0.
#   head zmax 0.108 at y 0.735 (the eye line), xw 0.238 there
#
# BUILD:  scripts/build-wam-kit.sh mouse
#   -> public/assets/lab/mouse-kit.gltf, which the lab loads (KITS in
#      lab-main.ts). WAM lives outside this repo, so the compiled glTF is
#      committed and that script records how to regenerate it.
#
# THREE OF WAM'S LINTS ALWAYS FIRE ON A KIT AND ARE CORRECT TO IGNORE (they
# check a whole CHARACTER; this is only the clothes): `spine1`/`neck`/`skull`
# carry no loft near them (that flesh lives in the .blob — the shades and
# brows are aimed from the skull but tiny), and the lowest geometry on the
# SHOES sits exactly ON the ground so "feet dipping below ground" will fire
# at 0 depth. A warning about anything else is real.
model mouse-kit
  height 1.10
  # chunky = 8-sided lofts. Same deliberate contrast as the goblin's plate:
  # faceted toy clothes against smooth raymarched clay skin.
  style chunky

palette
  # Measured off docs/dev-notes/refs/mouse-reference.png (sRGB, then converted
  # to WAM's palette hex directly — WAM bakes textures in sRGB):
  #   tee red: shadow #9B131D, lit #C71921 -> base between, #B1161F
  #   shorts blue: #1D27A4
  #   shoe grey: #B0B0B2 lit, #6E6E70 shade -> base #A9A9AC
  #   shoe toe/soul highlight + the brow frame: near-white #F2F2F2
  #   black: the shades' lenses and the brow slabs, #101012
  tee    #b1161f
  shorts #1d27a4
  shoe   #a9a9ac
  white  #f2f2f2
  black  #101012

skeleton
  # `hips` restores the .blob root bone's length — WAM's root is a bare point,
  # so parenting spine1 straight to it drops the trunk (see goblin-kit.wam's
  # note). Values are .blob metres / 1.10, pitch negated on `down` bones.
  # 2026-08-22: rebuilt to the reference rig joint heights (hip 0.353,
  # shoulder 0.622, neck-base 0.729, head-base 0.815).
  root pelvis at 0.2382
  bone hips   parent=pelvis dir=up len=0.0827
  bone spine1 parent=hips dir=up pitch=2 len=0.0782
  bone chest  parent=spine1 dir=up pitch=2 len=0.1664
  bone spine2 parent=chest dir=up pitch=-2 len=0.0973
  bone neck   parent=spine2 dir=up pitch=-5 len=0.0782
  bone skull  parent=neck dir=up pitch=-3 len=0.0909
  mirror
    # clavicle side 0.032 len 0.038; upperarm pitch -2 (blob) -> +2 here
    bone clavicle parent=chest    side=0.0291 dir=side len=0.0345
    bone upperarm parent=clavicle dir=down pitch=2  tilt=48 len=0.1045
    bone forearm  parent=upperarm dir=down pitch=-2 tilt=38 len=0.0864
    bone hand     parent=forearm  dir=down tilt=36 len=0.0500
    bone f_index  parent=hand dir=down tilt=26 pitch=-4 len=0.0455
    bone f_middle parent=hand dir=down tilt=10 pitch=-5 len=0.0500
    bone f_ring   parent=hand dir=down tilt=-6 pitch=-5 len=0.0473
    bone f_little parent=hand dir=down tilt=-20 pitch=-3 len=0.0409
    # thigh pitch 8 (blob) -> -8; shin -9 -> +9. Legs lengthened (0.110/0.105).
    bone thigh    parent=hips side=0.0309 dir=down pitch=-8 tilt=5 len=0.1000
    bone shin     parent=thigh dir=down pitch=9 tilt=-4 len=0.0955
    bone foot     parent=shin dir=fwd len=0.0909
  end

parts
  # EVERY PIECE IS AN OPEN SHELL — `cap ... none` almost throughout (the
  # shoes' soles are the deliberate exception: they are the ground contact).
  # A `cap flat` on a tube that wraps a limb puts a disc THROUGH the limb;
  # see goblin-kit.wam for the belt cap that sat 61 mm inside the goblin.
  mirror
    # ================================================================
    # SLEEVE — a loose short sleeve over the upper arm's top half.
    # The reference tee's sleeve is a wide bell: the arm is 0.051 across
    # and the sleeve mouth reads about double that. Flesh at the sleeve's
    # hem (upperarm t~0.55, y~0.47) is 0.051 dia -> 0.0463 here; the hem
    # flares to 0.105 while the top ring hugs the shoulder ball (0.060 dia
    # -> 0.055 + margin). Lofted down the upperarm with the mouth at the
    # BOTTOM (rings reversed: ring 0 at t=0.95 hem, ring 1 at t=0.40 top).
    # ================================================================
    loft sleeve bones=upperarm..upperarm material=tee
      ring 0.42 w=0.062 d=0.058
      ring 0.75 w=0.080 d=0.074
      ring 0.95 w=0.104 d=0.094
      cap start=none end=none

    # ================================================================
    # SHORTS — high-waisted, measured off the reference: waist up at the
    # tee's hem (hidden under it) and legs ending above the knee. 2026-08-22:
    # hip rose to 0.353, so the ray (offset 0.198 = 0.218 m above the hip)
    # starts the waist at ~0.571, under the tee's hem (0.509), and runs down
    # to a hem ~0.343 — above the new knee. Lofted on a FREE RAY down the
    # thigh's axis (thigh head 0.353 is BELOW the waist, so the ray starts
    # up at the pelvis and runs down), `follow=` off — stubby shorts do not
    # swing. The shorts clear the longer leg by ~4 cm because they are cut
    # wide.
    # ================================================================
    loft shortsleg bone=thigh at=0.0 offset=(0,0.198,0.005) dir=down pitch=-8 tilt=5 len=0.210 material=shorts frame=fwd
      ring 0.00 w=0.150 d=0.174
      ring 0.30 w=0.152 d=0.170
      ring 0.62 w=0.146 d=0.144
      ring 1.00 w=0.138 d=0.126
      cap start=none end=none

    # ================================================================
    # SHOE — the second-biggest read after the ears, and the 2026-08-22
    # proportion rebuild's whole reason to touch this file. The OLD shoe sat
    # its mouth ring at y~0 (a low floor wedge) while the ankle was at 0.141,
    # so it rendered as a detached white blob near the floor — the owner's
    # exact complaint. This one starts its ray AT the ankle (shin tail) and
    # pushes each ring DOWN with `up=` so the ring's BASE sits on the ground
    # (base = rayY + up - d/2). Ring 0 is a tall heel collar that wraps the
    # ankle (top ~0.165 > ankle 0.141) and runs to the floor; the ball
    # swells wide; the toe tapers to a lifted rounded front. Roughly the
    # reference's numbers: ankle mouth ~0.096 wide, ball ~0.168 wide, ~0.34
    # long, pale grey body, WHITE toe cap.
    # ================================================================
    # THEY SPLAY. Without `yaw` these two lofts both ran straight down +z and
    # FUSED INTO ONE POD: the ankles sit at x +/-0.031 while the ball ring is
    # w 0.140 and the sole w 0.150 (WAM `w` is FULL width, so ~0.070-0.075 of
    # half-width each), and each shoe therefore crossed the centreline by
    # about 40 mm. Measured off the built glTF, vertices below y 0.18 spanned
    # -0.112..+0.112 with NO trough at x=0, where two separate shoes show two
    # humps.
    #
    # Widening the stance cannot fix that on its own — these shoes are simply
    # broader than any believable gap between a mouse's ankles. Yawing them
    # outward can, and it is what the plates show: the length that was all in
    # +z now contributes to the x-span, and the two diverge instead of
    # overlapping. Span goes +/-0.112 -> +/-0.213 and the silhouette's shoe
    # band lands on the plate's 0.345 (0.354 at the widest).
    #
    # 25 degrees. The angle is flat between 23 and 27 — IoU 0.749/0.748, mean
    # width error 0.029 either way — and falls off past that (20 and 31 both
    # give 0.032), so this is the middle of a plateau rather than a peak
    # someone should try to sharpen.
    loft shoe bone=shin at=1.0 offset=(0,0,0.010) dir=fwd yaw=25 len=0.280 frame=up material=shoe
      ring 0.00 w=0.062 d=0.150 up=-0.053
      ring 0.20 w=0.084 d=0.140 up=-0.058
      ring 0.45 w=0.120 d=0.118 up=-0.066
      ring 0.65 w=0.140 d=0.098 up=-0.075
      ring 0.82 w=0.120 d=0.076 up=-0.083
      ring 0.92 w=0.080 d=0.056 up=-0.088 material=white
      ring 1.00 w=0.044 d=0.036 up=-0.092
      cap start=none end=none

    # SOLE — a flat slab under the shoe, the ground contact (flesh sole
    # floats at ankle height; the shoe bridges to 0). Same hanging-ring
    # trick: ray at the ankle, rings pulled down so the slab's base sits on
    # y 0, d = the slab's own ~0.021 thickness.
    loft sole bone=shin at=1.0 offset=(0,0,0.005) dir=fwd yaw=25 len=0.290 frame=up material=white
      ring 0.02 w=0.100 d=0.020 up=-0.118
      ring 0.50 w=0.150 d=0.022 up=-0.117
      ring 1.00 w=0.070 d=0.018 up=-0.120
      cap start=none end=none
  end

  # ================================================================
  # TEE — the torso shell. CROPPED over high-waisted shorts (the reference
  # boundary). 2026-08-22: the torso got much LONGER, so the old ray (off the
  # neck tail, 0.070 long) floated a thin red band up at the neck. This one
  # starts at the NECK BASE (0.729) and runs down 0.200 to a hem at ~0.509,
  # just above where the blue shorts begin. Loose drape: measured torso flesh
  # is half-width ~0.052 at the collar falling to ~0.065 at the waist (the
  # arms in the 0.11/0.18 columns are sleeves, not the body); the tee stays
  # boxier with 2-3 cm of drape all round.
  # ================================================================
  loft tee bone=neck at=0.0 dir=down len=0.200 material=tee frame=fwd
    ring 0.00 w=0.120 d=0.165
    ring 0.30 w=0.140 d=0.180
    ring 0.62 w=0.156 d=0.198
    ring 1.00 w=0.170 d=0.212
    cap start=none end=none

  # ================================================================
  # BROWS — two BLACK slabs at the crown hairline. Measured off the
  # reference: the black band runs y 0.877..0.925, splitting into two
  # wedges that stay separate down to y 0.83, inner edges tapering from
  # x 0.058 out to 0.104. They read as drawn-on angry brows pushed
  # right up under the hairline — the character's whole expression.
  # Aimed along a free ray running SIDEWAYS across the crown from just
  # off the centreline, tilting -13 (the measured outer slope), with
  # frame=fwd so `d` is the slab's height and `w` its fore-aft depth.
  # MIRRORED — the first draft sat outside the mirror block and BOTH
  # brows landed on the character's left (x to +0.154), which the
  # viewer's part bounds caught immediately.
  #
  # THE z IS THE WHOLE BROW, and the first compiled kit got it wrong:
  # offset z 0.010 left 66 of 72 vertices INSIDE the skull — the crown's
  # front face at brow height is z 0.05-0.08, so a slab centred at 0.01
  # is buried whole and the kit rendered browless (invisible while the
  # kit itself was unbuilt — two silent failures stacked). z 0.066 puts
  # the slab's back rim ~20 mm into the crown (a deliberate tuck — a rim
  # that stops AT the smin surface gaps yellow at its edges) and its
  # face ~5-10 mm proud. len 0.100 reached x 0.169, past the head's
  # 0.099 half-width at that height — the wedges floated off the
  # temples; 0.048 lands the outer tip at x 0.099, the reference's
  # 0.104. The crown falls away fast under the tip, so the tip ring
  # pinches to w 0.016: the wedge end lifting off the skull IS the
  # angry-brow read, but a fat floating end reads as a horn.
  # ================================================================
  mirror
    # 2026-08-22: the skull bone got much shorter, so the old offset.y 0.120 (a
    # hairline 0.13 above the t=0.436 anchor) pushed the brows to the CROWN
    # (y~0.99) and offset.z 0.066 left the slab BEHIND the crown front so its
    # back rim tucked ~37 mm into the skull (over the 30 mm tolerance). Lowered
    # offset.y to 0.045 (slab centre ~0.908, the hairline) and moved offset.z
    # to 0.100 so the slab straddles the front face (~0.11 there) and tucks
    # only ~2 cm at the rim.
    loft brow bone=skull at=0.436 offset=(0.052,0.045,0.100) dir=side tilt=-13 len=0.048 frame=fwd material=black
      ring 0.00 w=0.034 d=0.030
      ring 0.35 w=0.038 d=0.040
      ring 0.70 w=0.032 d=0.044
      ring 1.00 w=0.016 d=0.046
      cap start=none end=none
  end

  # ================================================================
  # SHADES — one bar across both eyes, NOT a mirrored pair (a mirror block
  # would leave a gap over the nose; real shades are a single sweep — see
  # goblin-kit.wam). Measured: the lens band sits y 0.728..0.769 (the dark
  # band between the brows above and the yellow muzzle below), spanning
  # x -0.088..+0.088 and bulging 8 mm proud of the face at z 0.116.
  # `frame=up` pins the ring axes: `d` = lens HEIGHT, `w` = fore-aft
  # thickness. Solid near-black, not smoked: the goblin tried transparent
  # lenses and the SDF composite ate them (see kit-overlay.ts LOOK.glass).
  # The band's own dark-measured pixels are (50,48,2)..(59,57,0) — i.e.
  # BLACK with a yellow key-light sheen, which near-black + low roughness
  # reproduces without transparency.
  # ================================================================
  # 2026-08-22: shifted the band to the raised eye line (offset.y 0.018 ->
  # centre ~0.867, between the brows at 0.908 and the snout top ~0.85) and
  # pushed it a touch prouder (z 0.120) so it reads as worn, not embedded.
  loft shades bone=skull at=0.325 offset=(-0.098,0.018,0.120) dir=side len=0.196 frame=up material=black
    ring 0.00 w=0.014 d=0.026 tip
    ring 0.12 w=0.020 d=0.036
    ring 0.40 w=0.018 d=0.038
    ring 0.60 w=0.018 d=0.038
    ring 0.88 w=0.020 d=0.036
    ring 1.00 w=0.014 d=0.026 tip
    cap start=point end=point

textures
  texture tee base=#b1161f
    # soft cotton fold shading, hand-painted not realistic
    noise scale=0.16 amount=0.05
    ao amount=0.14
  texture shorts base=#1d27a4
    noise scale=0.14 amount=0.04
    ao amount=0.14
  texture shoe base=#a9a9ac
    gradient axis=v from=-0.05 to=0.12
    noise scale=0.10 amount=0.03
    ao amount=0.12
  texture white base=#f2f2f2
    gradient axis=v from=-0.02 to=0.08
    ao amount=0.10
  texture black base=#101012
    # the lens shine is the whole read of a near-black lens; WAM's texture
    # gradient fakes the key-light band the material itself cannot
    gradient axis=v from=-0.02 to=0.06
