# Mouse kit — the POLYGON half of the mouse, authored in WAM.
#
# WHY TWO LANGUAGES FOR ONE CHARACTER. .blob builds flesh out of blended
# signed-distance primitives, and smooth-min rounds every edge it touches, so
# a tee's hem, a brow slab's crease or a shoe sole is either smeared or has
# to be fought back with `hard` blends. WAM is a text→glTF mesh compiler,
# which is the other half of that trade. Flesh in .blob, clothes in .wam —
# same bargain as goblin-kit.wam, whose header says it in full.
#
# THE SKELETON BELOW MIRRORS characters/mouse.blob AND MUST TRACK IT. Two
# conversions apply and neither is optional (see goblin-kit.wam for the full
# versions):
#
#   * UNITS. WAM lengths are fractions of `height`; .blob's are metres. Every
#     number here is the .blob metre value / 1.10.
#   * PITCH SIGN ON `down` BONES. WAM's pitch tips an `up` bone forward and a
#     `down` bone BACKWARD; .blob's always carries toward +z. So `up` bones
#     (spine1, chest, neck, skull) share their pitch verbatim, and every
#     `down` bone (upperarm, forearm, thigh, shin) has it NEGATED.
#     .blob's arms: upperarm pitch=-2, forearm pitch=2, hand pitchless.
#     .blob's legs: thigh pitch=8, shin pitch=-9. `tilt` needs no flip.
#
# RING SIZES ARE MEASURED, NOT EYEBALLED — marched off the .blob field
# (see the numbers scattered through this file), in metres there / 1.10 here.
# Measured flesh, for reference:
#   torso y0.30 w=0.146 d=0.180   y0.36 w=0.130 d=0.159   y0.42 w~0.130 d=0.109
#   y0.48 w~0.128 d=0.116  y0.51 w=0.109 d=0.099  y0.54 w=0.080 d=0.080
#   arm  0.051 dia at the forearm, 0.044 at the wrist
#   leg  0.058..0.067 wide, 0.056 deep at the knee..ankle
#   ankle joint centre y 0.162, flesh sole 0.138 — the shoe bridges to 0.
#   head zmax 0.108 at y 0.735 (the eye line), xw 0.238 there
#
# BUILD:  scripts/build-wam-kit.sh mouse
#   -> public/assets/lab/mouse-kit.gltf, which the lab loads (KITS in
#      lab-main.ts). WAM lives outside this repo, so the compiled glTF is
#      committed and that script records how to regenerate it.
#
# THREE OF WAM'S LINTS ALWAYS FIRE ON A KIT AND ARE CORRECT TO IGNORE (they
# check a whole CHARACTER; this is only the clothes): `spine1`/`neck`/`skull`
# carry no loft near them (that flesh lives in the .blob — the shades and
# brows are aimed from the skull but tiny), and the lowest geometry on the
# SHOES sits exactly ON the ground so "feet dipping below ground" will fire
# at 0 depth. A warning about anything else is real.
model mouse-kit
  height 1.10
  # chunky = 8-sided lofts. Same deliberate contrast as the goblin's plate:
  # faceted toy clothes against smooth raymarched clay skin.
  style chunky

palette
  # Measured off docs/dev-notes/refs/mouse-reference.png (sRGB, then converted
  # to WAM's palette hex directly — WAM bakes textures in sRGB):
  #   tee red: shadow #9B131D, lit #C71921 -> base between, #B1161F
  #   shorts blue: #1D27A4
  #   shoe grey: #B0B0B2 lit, #6E6E70 shade -> base #A9A9AC
  #   shoe toe/soul highlight + the brow frame: near-white #F2F2F2
  #   black: the shades' lenses and the brow slabs, #101012
  tee    #b1161f
  shorts #1d27a4
  shoe   #a9a9ac
  white  #f2f2f2
  black  #101012

skeleton
  # `hips` restores the .blob root bone's length — WAM's root is a bare point,
  # so parenting spine1 straight to it drops the trunk (see goblin-kit.wam's
  # note). Values are .blob metres / 1.10, pitch negated on `down` bones.
  # 2026-08-22: rebuilt to the reference rig joint heights (hip 0.353,
  # shoulder 0.622, neck-base 0.729, head-base 0.815).
  root pelvis at 0.2382
  bone hips   parent=pelvis dir=up len=0.0827
  bone spine1 parent=hips dir=up pitch=2 len=0.0782
  bone chest  parent=spine1 dir=up pitch=2 len=0.0827   # 0.091 m: shoulder at 0.530, off the mesh surface
  bone spine2 parent=chest dir=up pitch=-2 len=0.0636   # 0.070 m: collar at 0.600
  # Tracks the .blob: collar 0.600 up to the head base 0.817, 0.217 m /
  # 1.10 = 0.1973. The shades and brows are aimed off `skull`, so if this does
  # not track the .blob they float off the face by the distance the head moved.
  bone neck   parent=spine2 dir=up pitch=-2 len=0.1973
  bone skull  parent=neck dir=up pitch=0 len=0.0909
  mirror
    # clavicle side 0.032 len 0.038; upperarm pitch -2 (blob) -> +2 here
    bone clavicle parent=chest    side=0.0291 dir=side len=0.0345
    bone upperarm parent=clavicle dir=down pitch=2  tilt=48 len=0.1045
    bone forearm  parent=upperarm dir=down pitch=-2 tilt=38 len=0.0864
    bone hand     parent=forearm  dir=down tilt=36 len=0.0500
    bone f_index  parent=hand dir=down tilt=26 pitch=-4 len=0.0455
    bone f_middle parent=hand dir=down tilt=10 pitch=-5 len=0.0500
    bone f_ring   parent=hand dir=down tilt=-6 pitch=-5 len=0.0473
    bone f_little parent=hand dir=down tilt=-20 pitch=-3 len=0.0409
    # thigh pitch 8 (blob) -> -8; shin -9 -> +9. Legs lengthened (0.110/0.105).
    bone thigh    parent=hips side=0.0382 dir=down pitch=-8 tilt=5 len=0.1000
    bone shin     parent=thigh dir=down pitch=9 tilt=-4 len=0.0955
    bone foot     parent=shin dir=fwd len=0.0909
  end

parts
  # EVERY PIECE IS AN OPEN SHELL — `cap ... none` almost throughout (the
  # shoes' soles are the deliberate exception: they are the ground contact).
  # A `cap flat` on a tube that wraps a limb puts a disc THROUGH the limb;
  # see goblin-kit.wam for the belt cap that sat 61 mm inside the goblin.
  mirror
    # ================================================================
    # SLEEVE — a loose short sleeve over the upper arm's top half.
    # The reference tee's sleeve is a wide bell: the arm is 0.051 across
    # and the sleeve mouth reads about double that. Flesh at the sleeve's
    # hem (upperarm t~0.55, y~0.47) is 0.051 dia -> 0.0463 here; the hem
    # flares to 0.105 while the top ring hugs the shoulder ball (0.060 dia
    # -> 0.055 + margin). Lofted down the upperarm with the mouth at the
    # BOTTOM (rings reversed: ring 0 at t=0.95 hem, ring 1 at t=0.40 top).
    # ================================================================
    # Starts at the SHOULDER, not 42% down the arm. The mesh sleeves leave
    # the body at its top corners (0.20 half-wide at y 0.54-0.56), and with
    # the tee only 0.083 half-wide at that height the shoulder balls (r 0.040
    # at x 0.07) stood 8 mm proud of it — bare yellow shoulders either side
    # of a red shirt. The top ring wraps the ball with 5 mm to spare.
    loft sleeve bones=upperarm..upperarm material=tee
      ring 0.05 w=0.104 d=0.100
      ring 0.42 w=0.082 d=0.076
      ring 0.75 w=0.080 d=0.074
      ring 0.95 w=0.104 d=0.094
      cap start=none end=none

    # ================================================================
    # SHORTS — two legs, each its own tube, cut to the mesh. The mesh shorts
    # are 0.168 across at the waist (y 0.30..0.34, the legs merged into one
    # block) and end at a hem about y 0.25, where the bare legs — 0.071 across
    # each, centred at x 0.048 — take over. The previous rings were 0.165 m
    # wide PER LEG: the two tubes overlapped into one slab twice the width of
    # the body. Waist starts at 0.40, hidden under the tee's 0.347 hem; the
    # rings narrow from a merged waist to a per-leg hem of 0.090 m (flesh
    # 0.071 + drape) whose outer edge lands at x 0.093 against the mesh's
    # 0.084..0.088. Lofted on a free ray down the thigh's axis, `follow=`
    # off — stubby shorts do not swing.
    # ================================================================
    loft shortsleg bone=thigh at=0.0 offset=(0,0.0427,0.005) dir=down pitch=-8 tilt=5 len=0.136 material=shorts frame=fwd
      ring 0.00 w=0.118 d=0.166
      ring 0.50 w=0.102 d=0.132
      ring 1.00 w=0.088 d=0.101
      cap start=none end=none

    # SHOES: no longer here — painted SDF primitives in mouse.blob (see the
    # foot bone's prims there). The mesh has no foot and no seam at the ankle,
    # and a loft shoe hung under a floating yellow foot however it was cut.
  end

  # ================================================================
  # TEE — the torso shell. CROPPED over high-waisted shorts (the reference
  # boundary). Cut to the MESH, frame-aligned, with 1.5 cm of drape: the
  # torso under it is 0.132 wide x 0.144 deep at the collar (y 0.60) and
  # 0.158 x 0.155 at the hem (0.35). The previous tee's hem ring was 0.233 m
  # deep — 8 cm more than the body it dressed — which is most of why the
  # torso read as a barrel. Collar at the neck base (0.600), 0.230 down to a
  # hem at 0.347, just above the shorts.
  # ================================================================
  # FACET CORRECTION. `style chunky` lofts are 8-sided, and a facet's middle
  # sits at cos(22.5) = 92.4% of the ring's nominal radius. The first cut of
  # these rings put the chest facet at 0.081 against a flesh front of 0.087 —
  # a 6 mm stripe of yellow down the middle of the shirt. Depths carry 12%
  # and widths 8% over the mesh-plus-drape numbers in the comment above.
  # THE COLLAR HUGS THE NECK. At w 0.149 the mouth was 0.082 half-wide around
  # a 0.046 neck, and any camera above the shoulders looked straight down
  # the inside of the shirt: the chest flesh showed as a yellow strip from
  # the collar to mid-chest, narrowing with depth — hunted first as flesh
  # poking through the fabric (it was 11-20 mm clear), then as a specular
  # band, then as a UV seam. It was the opening. The mesh collar is 0.066
  # half-wide at y 0.60 around a 0.049 neck; ring 0 now sits ~10 mm off ours
  # after the facet loss (2 mm was inside the depth-composite fuzz) and flares
  # to the body by ring 0.08.
  loft tee bone=neck at=0.0 dir=down len=0.230 material=tee frame=fwd
    ring 0.00 w=0.118 d=0.150
    ring 0.08 w=0.152 d=0.168
    ring 0.30 w=0.162 d=0.179
    ring 0.62 w=0.173 d=0.186
    ring 1.00 w=0.186 d=0.188
    cap start=none end=none

  # SHADES AND BROWS: no longer here. They are painted SDF geometry in
  # mouse.blob (color=101012 on blob primitives) — the reference mesh has
  # them as a glossy bump on the face, not a separate object, and a loft
  # bar across a curved face only ever read as wire.

textures
  texture tee base=#b1161f
    # soft cotton fold shading, hand-painted not realistic
    noise scale=0.16 amount=0.05
    ao amount=0.14
  texture shorts base=#1d27a4
    noise scale=0.14 amount=0.04
    ao amount=0.14
  texture shoe base=#a9a9ac
    gradient axis=v from=-0.05 to=0.12
    noise scale=0.10 amount=0.03
    ao amount=0.12
  texture white base=#f2f2f2
    gradient axis=v from=-0.02 to=0.08
    ao amount=0.10
  texture black base=#101012
    # the lens shine is the whole read of a near-black lens; WAM's texture
    # gradient fakes the key-light band the material itself cannot
    gradient axis=v from=-0.02 to=0.06
