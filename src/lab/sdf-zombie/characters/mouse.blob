# Mouse — the third .blob character authored from scratch, and the second
# built to be CUTE (after the clown). Authored against THREE references in
# docs/dev-notes/refs/: mouse-reference.png (front), mouse-reference-1.png
# (PURE SIDE PROFILE — the one that matters; two earlier runs worked from
# the front view alone, which hides the snout completely, and both built a
# flat face), and mouse-reference-2.png (three-quarter).
#
# SILHOUETTE INTENT, measured off the references (945 px of front character
# mapped to 1.10 m, so 1 px = 1.164 mm; the profile is 755 px = 1.10 m, so
# 1 px = 1.457 mm): a lollipop WITH A SNOUT. In profile the head is 33% of
# the standing height FRONT-TO-BACK (0.364 m — the muzzle is roughly as
# long as the cranium is deep, and ends in a blunt rounded nose 49 mm below
# the eye line, held near-horizontal with a gentle droop, a small pout
# under its far end). From the front: two enormous ROUND ear discs
# (diameter 0.254 m each, i.e. nearly a QUARTER of the standing height
# EACH) centred at (+/-0.174, 0.960) and reaching y 1.099 — the ears, not
# the crown, are the tallest thing on the body. Between them the crown
# pokes up to 0.972 as a narrow yellow dome; the head then flares to its
# full 0.262 width at y 0.85 and tapers back to a 0.10-wide chin at 0.645,
# over a stick neck. Below: a small torso in a loose red tee, blue shorts,
# bare shins, and shoes as oversized as the ears (0.17 m wide, reaching to
# y 0.187). Arms SPINDLY and held out at ~47 degrees, hands at hip height
# with spread fingers.
#
# THE OUTFIT IS PAINT (2026-08-22). The reference mesh is one sculpt with
# painted regions, and so is this file: tee, shorts, shoes and sunglasses
# are `color=` on primitives (see the per-primitive colour note in
# types.ts). There is no kit. Measured off the mesh's own texture — every
# vertex classified by its texel — the tee is the torso painted red with NO
# drape (front 0.075, back -0.075, exactly the torso), the shorts are the
# pelvis and thighs painted blue from y 0.19 to the hem at ~0.31, the shoes
# are grey, and only the sleeves have volume of their own.
#
# THE EARS ARE THE WHOLE CHARACTER. Every other feature serves them. They are
# ROUND PLATES — as wide as they are tall, like coins stood on the skull's
# flanks — set so their inner edges sink 20 mm into the crown at its dome.
# Not spheres worn as Mickey ears, not columns: the FIRST pass here authored
# each ear as two prims and rendered as two tall narrow columns standing
# straight up; the rescue pass made them one prim but kept the numbers of the
# comment that produced the columns. This version re-measures the image: each
# disc is 0.254 m across and ROUND (see mouse-blob.test.ts, which pins the
# width/height ratio to keep them discs).
model mouse
  height 1.10
  # humanoid | digitigrade. Checked, not decorative — see blob-checks.ts.
  stance humanoid

skeleton
  # LOLLIPOP STACK, measured off the reference MESH SURFACE — not its rig.
  # The previous stack took joint heights from the maus-biped skeleton's bind
  # matrices (shoulder 56.5%, neck-base 66.3%) and they do not sit where the
  # skin does: marched off the mesh (docs/dev-notes/refs/maus-biped, scaled
  # 1.700 -> 1.10 and frame-aligned on the torso), the T-posed arms span
  # y 0.48..0.58 so the shoulder is at ~0.53 (48%), the tee collar and the
  # visible neck start at 0.60 (55%), the chin is at 0.66 and the cranium
  # centre at 0.86. Built to the old numbers the shoulders sat 9 cm and the
  # collar 13 cm too high — the whole torso was a head taller than the mesh's.
  # Crotch 0.26, hip line 0.353, shoe top ~0.15 are unchanged.
  root pelvis at 0.262 len=0.091     # pelvis tail = hip line (0.353)

  bone spine1 parent=pelvis dir=up pitch=2 len=0.086   # hips->chest
  bone chest  parent=spine1 dir=up pitch=2 len=0.091   # -> shoulder (clavicle attach, 0.530)
  # Shoulder up to the tee collar. The mesh has no trapezius: above the arm
  # band (0.58) the silhouette is 0.066 half-wide at 0.60 and a 0.049 neck by
  # 0.62.
  bone spine2 parent=chest  dir=up pitch=-2 len=0.070  # -> collar / neck base (0.600)
  # NEAR-VERTICAL, AND THAT WAS CHECKED THE HARD WAY. A first pass at the
  # mesh read the cranium centre at z -0.068 and leaned this bone back 40
  # degrees to put the skull there — which set the head 65 mm behind the
  # torso, because the mesh's TORSO is at z -0.067 as well: its whole figure
  # sits that far behind our frame's origin. Measured relative to the torso
  # front, the mesh forehead is 45 mm proud and the snout tip 180 mm, and a
  # vertical neck gives 42 and 178. Compare frames, not absolute z
  # (scripts/head-profile.ts now aligns on the torso for exactly this reason).
  # len 0.088 puts the bone head at y 0.817 and the cranium at 0.862; the mesh
  # skull is centred at 0.86 with the ear rims at 1.095.
  # Collar to head base. Long, because the skull bone's head has to stay at
  # 0.817 for the cranium to centre at 0.862 — the visible neck is only the
  # 0.60..0.67 of it below the lower face; the rest runs up inside the head.
  bone neck   parent=spine2 dir=up pitch=-2 len=0.217  # tail (0, 0.817, -0.008)
  # Vertical. The skull bone only positions prims.
  bone skull  parent=neck   dir=up pitch=0  len=0.100

  mirror
    # Arms: LONGER than before (the reference limbs are lanky) and HELD OUT.
    # shoulder joint = clavicle tail = chest tail (0.622). tilt is WORLD-axis
    # on a down bone, so 48/38/36 is one nearly straight line (the reference
    # arm does not bend at the elbow); the splay doubles as the pose AND the
    # torso clearance — see daylightOf in mouse-blob.test.ts.
    bone clavicle parent=chest    side=0.032 dir=side  len=0.038
    bone upperarm parent=clavicle dir=down pitch=-2 tilt=48 len=0.115
    bone forearm  parent=upperarm dir=down pitch=2  tilt=38 len=0.095
    # The hand bone needs its OWN tilt: dir=down with no tilt points at the
    # FLOOR whatever the forearm did (world axes, not parent-relative — the
    # trap the old forearm comment records). 36 continues the arm line.
    bone hand     parent=forearm  dir=down tilt=36 len=0.055
    # Legs: LONG now. Hip line 0.353, knee ~0.244, ankle ~0.140 where the
    # kit's shoe swallows the joint. Thigh forward / shin back per the
    # kangaroo-knee rule, splayed by tilt so the longer shin clears the body.
    bone thigh    parent=pelvis   dir=down tilt=5  pitch=8  side=0.042 len=0.110
    bone shin     parent=thigh    dir=down tilt=-4 pitch=-9         len=0.105
    bone foot     parent=shin     dir=fwd                            len=0.100
    # FINGER BONES, not tipped prims. When these were written expandMirror
    # did NOT flip a mirrored prim's tip (only the bone's dir), so a fan of
    # tipped bars on the hand bone would have pointed the right index finger
    # INWARD across the chest; bones mirrored correctly, so each finger got
    # one. expandMirror reflects offset/tip/bend x on the .r copy now
    # (2026-08-22, for the SDF shoes) — the bones stay because they are also
    # what the rig articulates. Splay: index out +26, little in
    # -20, middle/ring between — the reference hands spread wide.
    bone f_index  parent=hand dir=down tilt=26 pitch=4 len=0.056
    bone f_middle parent=hand dir=down tilt=10 pitch=5 len=0.060
    bone f_ring   parent=hand dir=down tilt=-6 pitch=5 len=0.056
    bone f_little parent=hand dir=down tilt=-20 pitch=3 len=0.048
  end

body
  # Torso: SMALL and narrow — the tee wears this, not the other way round.
  # Deep in z like every character here, but the absolute widths are
  # toy-scale: the widest ring is 0.148 across, against the goblin's 0.192
  # and the ear discs' 0.508 pair span.
  blob torso on pelvis at=0.00 r=0.058 deep=1.15 blend=0.0045 color=1d27a4
  # deep 1.15, not 1.30: the mesh torso's back at y 0.34 is -0.080, and at
  # 1.30 this blob reached -0.091 — 16 mm out through the back of the shorts
  # just below the tee hem, the one place nothing else covers it.
  blob torso on pelvis at=0.95 r=0.070 deep=1.15 blend=0.0050 color=b1161f
  blob torso on spine1 at=0.60 r=0.066 deep=1.20 blend=0.0062 color=b1161f
  # Mesh torso, 0.26..0.46: half-width 0.064..0.079, half-depth 0.075 both
  # ways — a near-cylinder, slightly deeper than wide. AND THAT 0.075 IS THE
  # SHIRT: the mesh is dressed, so the flesh under it has to sit a fabric's
  # thickness inside. At deep 1.15 these blended out to a 0.087 chest front,
  # 12 mm past the mesh's dressed surface, and the tee cut to the mesh
  # cleared it by 4-7 mm — close enough that the half-res SDF depth and the
  # polygon depth disagreed along the shirt's centre facet, and a yellow
  # stripe ran down the front. deep 1.00 puts the chest at ~0.070.
  blob torso on chest  at=0.30 r=0.065 deep=1.00 blend=0.0055 color=b1161f
  blob torso on chest  at=0.50 r=0.065 deep=1.00 blend=0.0055 color=b1161f
  # Armpit filler — the wedge between the upper arm's inner edge and the
  # narrow upper chest. Without it the shoulder join reads a hair of air
  # right below the shoulder ball (measured +0.004-0.008 on the arm->torso
  # probe), which flags the arm as disconnected even though it LOOKS fused.
  blob torso on chest  at=0.72 r=0.065 deep=1.00 blend=0.0055 color=b1161f
  blob torso on chest  at=1.00 r=0.065 deep=1.00 blend=0.0050 color=b1161f
  # Upper chest / collarbone region, on the spine2 bone that runs from the
  # shoulder (chest tail 0.622) up to the neck base (0.729). This is what
  # keeps the head cluster fused to the torso: the neck stalk rides the neck
  # bone ABOVE 0.729, so without flesh here there is a gap right where the
  # collar sits and the validation flags the head as disconnected.
  # Between the shoulder and the neck base the plate is 0.093 m across — a
  # NECK. This read 0.178 there, because these two were 0.124 wide before the
  # tee's drape was even added. The reference mouse has no trapezius to speak
  # of: the neck runs straight down and the shoulders start abruptly under it.
  blob torso on spine2 at=0.00 r=0.052 deep=1.00 blend=0.0045 color=b1161f
  blob torso on spine2 at=1.00 r=0.036 deep=0.88 blend=0.0040 color=b1161f

  # Neck column. "A stick" was the right read and the wrong number: the mesh
  # neck is 0.043 half-width at y 0.66 and 0.061 at 0.62, spanning z
  # +0.016..-0.122 — twice what 0.022 gave. Frame-aligned (+0.067) that is
  # 0.08 in front to -0.055 behind: deep 1.35 on r 0.046 covers it.
  bar head on neck from=0.00 to=1.00 r=0.046 deep=1.35 blend=0.0040

  # ============================================================
  # EARS — the character. Read this block before touching anything.
  # ============================================================
  #
  # WHAT THE REFERENCE SHOWS, measured px by px. The old comment here claimed
  # "each ear ~0.303 wide x 0.249 tall" — that 0.303 is the PAIR's span
  # (each disc measured from the centreline out, which counts the head
  # between them), and it steered every later pass wrong: ears wider than
  # tall, inner edges near the centreline, and a 27-degree rising chord that
  # made the whole plate read as a leaning lozenge. Re-measured properly:
  # each disc is a CIRCLE of diameter 0.254 m (218 px), centred at
  # (+/-0.174, 0.960) — as wide as it is tall, only ~0.07 thick, its inner
  # edge at |x| 0.047 where the crown at that height reaches |x| 0.059. So
  # the disc OVERLAPS the skull by ~18 mm at its inner rim and hangs 0.10 m
  # clear beyond it. The pair's silhouette merges with the crown from y 0.90
  # down (the reference's ear/head outline is one continuous run there) and
  # the two discs stay separate above, exactly what smin does here.
  #
  # ONE flattened sphere per side, not a capsule: a blob with no tip is a
  # sphere, and world-axis scale (wide 1.0, tall 1.0, deep 0.30) flattens it
  # into the plate — round in x/y by construction (which is the whole fix;
  # a capsule's caps bulge along its chord and read as a pill), 0.077 thick
  # in z. r=0.128 puts the rim at 1.088: the discs, not the crown, own the
  # standing height, as in the reference. blend stays tight (0.0028) so the
  # crease where plate meets skull survives; chamfer sharpens it a touch
  # more. The anchor sits at skull t=0.44 (y 0.785); offset=(0.170, 0.170)
  # lands the centre at (0.170, 0.955) — 4 mm inside the measured 0.174, so
  # the weld has margin to spare.
  # SPAN, measured the same way: the reference's widest point across the ears
  # is 55.1% of body height and this was 65.4% — 19% too wide, which reads as
  # the ears having eaten the head. offset.x 0.183 -> 0.150 and r 0.128 ->
  # 0.120 lands it at ~55%. The reference's widest row also sits 16% down
  # rather than 12%, so the pair drops 12 mm with it.
  # 2026-08-22, measured with scripts/silhouette-match.ts against the DRESSED
  # figure: the ear band read 0.498 of body height against the plate's 0.551,
  # so the discs had been trimmed one pass too far chasing an earlier
  # over-wide reading. r 0.120 -> 0.130 and offset.x 0.150 -> 0.170 spends it
  # back; both guards still hold with room (inner rim 0.040 against its 0.06
  # ceiling, centre 0.170 against 0.21).
  #
  # They also sat one band too LOW. The plate's outline collapses from 0.525
  # to 0.241 between 0.203 and 0.234 of height — the discs end and only the
  # cranium is left — while ours was still 0.449 there because the discs hung
  # down to y 0.825. offset.y 0.111 -> 0.128 clears that band.
  # STILL ROUND, and the band below the ears is the price. The plate's outline
  # falls off a cliff there — 0.525 at 0.203 to 0.241 at 0.234 — because its
  # ears are flat-bottomed lobes that simply END. An ellipse cannot do that:
  # squashing this to tall=0.84 nails the 0.234 band (-0.001) and immediately
  # ruins 0.203 (-0.097), because the taper just moves up a band. Measured
  # over the whole figure:
  #
  #   tall 1.00   IoU 0.705   mean width error 0.048   <- kept
  #   tall 0.95   IoU 0.700   0.048
  #   tall 0.90   IoU 0.689   0.050
  #   tall 0.84   IoU 0.685   0.053
  #
  # So the round disc wins on aggregate and the cliff stays unmatched. The
  # real fix is a flat-bottomed ear, which needs TWO prims per side (a wide
  # lobe with a squarer lower rim), not a different scale on this one.
  # Re-seated off the mesh: the ear plates are centred in the cranium's own
  # plane (frame-aligned z -0.007), and the pair's outer edge peaks at x 0.307
  # from y 0.92 to 0.96, i.e. centre (0.18, 0.95), radius 0.127. offset.y
  # 0.105 puts ours at 0.966 with the rim at 1.096 (mesh 1.095). deep 0.45:
  # measured 0.14 thick at the rim, not the coin we had.
  # "THE EARS ARE STILL TOO ROUND" (owner, 2026-08-22) — and the mesh says
  # exactly how: its ear is an ELLIPSE 0.26 wide by 0.23 tall (x 0.047..0.307,
  # y 0.87..1.10), centred at (0.177, 0.985), whose flat-ish bottom stops at
  # the brow line. Ours was a 0.26 circle centred at 0.966, so its bottom
  # hung to 0.836 and bulged out past the skull below where the real ear had
  # already ended — that bulge is the "round" read. tall 0.88 and centre
  # 0.985 put the rim at 0.871..1.099 against the mesh's 0.87..1.10; the
  # width is unchanged and already matched. Still inside the test's
  # roundness guard (1.14 of 1.25).
  blob head on skull at=0.44 r=0.130 wide=1.00 tall=0.88 deep=0.45 blend=0.0028 chamfer offset=(0.170,0.124,0.000) both
  # THE DISH. The reference ears are cupped — a shallow concave front face
  # inside a rim — and the owner was right that shading could fake it, but a
  # soft carve gives the real thing and the marcher shades it itself. An
  # ellipsoid 0.19 x 0.17 x 0.047, centred 0.076 in front of the plate
  # (0.070 left the plate's occluder-hull sphere 0.7 mm proud: the smooth
  # blend bites deeper at the centre than the rim reading shows)
  # (whose front face sits at z 0.050), bites 4 mm into the face and leaves a
  # ~3.5 cm rim all round; blend 0.004 rounds the lip instead of cutting a
  # step. Smooth, not `hard`: a crease here would read as a second ear
  # drawn inside the first.
  carve on skull at=0.44 r=0.095 wide=1.00 tall=0.88 deep=0.25 blend=0.0040 offset=(0.170,0.124,0.076) both

  # ============================================================
  # THE SNOUT — the whole character after the ears. ONE bent tapered prim,
  # not a chain (the goblin nose lesson): `r2=` tapers it, `tip=` sweeps it
  # forward off the vertical skull bone, `bend=` gives the gentle droop.
  # ============================================================
  #
  # WHY IT EXISTS: two runs authored from the flat front reference alone and
  # built a flat face. mouse-reference-1.png (pure profile) shows a muzzle
  # roughly AS LONG AS THE CRANIUM IS DEEP. Measured off that image by
  # threshold (755 px of body = 1.10 m): cranium back x=102, snout tip
  # x=352, total head depth 250 px = 33% of body height -> 0.364 m. The
  # cranium's semi-depth is headRadius 0.131 x headDepth 0.95 = 0.124, so
  # the tip must land near z +0.25 from the cranium centre — over 0.13 m
  # PROUD of the front face, against the goblin nose's 44 mm. Anything
  # shorter reads as a bump however sharp it is.
  #
  # AIM: the profile's muzzle leaves the face LOW, at cheek/under-eye level,
  # and holds nearly HORIZONTAL with a gentle downward taper to a blunt
  # rounded nose (not the goblin's hook). The base sits at y 0.73 (just
  # under the 0.749 eye line the shades wear), 50 mm inside the cranium's
  # 0.105 front face at that latitude; the tip ends at y 0.70, z 0.240, so
  # with r2 the surface crests z ~0.25 and the head's front-to-back total
  # is ~0.365 m — 33% of the standing height, the reference's own number
  # (measured on the compiled field: front 0.248, back -0.116, depth 0.364;
  # the nose tip lands 49 mm under the eye line, the reference's own drop).
  # tip= is a displacement from the base (offset moves BOTH ends), so
  # (0,-0.030,0.190) carries base (0,0.73,0.05) to tip (0,0.70,0.240).
  # bend= pushes the Bezier control UP and OUT from the chord midpoint
  # (0,0.715,0.138); the apex bulges half that, so the top line sweeps out
  # nearly level before it dips — the reference's straight-out-then-gentle-
  # droop, which a bare chord (already sloping down) cannot do.
  #
  # Section: r 0.042 at the root (x-semi 0.050 with wide=1.2 — under half
  # the 0.262 face width, the reference's muzzle-to-cheek ratio) falling to
  # a blunt 0.016 bulb at the nose. NO chamfer: the muzzle must MELT into
  # the cranium, a crease here would read as a stuck-on trunk.
  # 2026-08-22, owner review: "the snout is too narrow" and "there is a round
  # nose but there isn't one in the reference". Both fall out of the same two
  # numbers. The root was r 0.042 x wide 1.20 = 0.050 of x-semi, so the muzzle
  # left the face thinner than the gap between the shades' lenses and read as
  # a beak stuck on; and tapering that to r2 0.016 ended it in a bulb small
  # and round enough to read as a BALL NOSE, which mouse-reference-2.png
  # plainly has not got — the muzzle there simply stops, blunt, at about a
  # third of its root width. So the root goes up and the tip goes up TOO:
  # blunter reads as less nose-like, not more. Longer and dropping further
  # with it, so the muzzle sweeps down the way the profile plate shows instead
  # of sticking out level at eye height.
  # ROUND IN SECTION. wide 1.15 against tall 0.88 made the muzzle a horizontal
  # BLADE — 31% wider than tall — and on screen it read as a flat yellow flap
  # stuck to the side of the face rather than a snout. The front silhouette
  # cannot see this at all (it only measures width), which is exactly the kind
  # of error the matcher is blind to and the render is not. A muzzle is round
  # in cross-section and tapers; the width belongs in `r`, not in a squash.
  # A STRAIGHT CONE, rooted inside the cranium, measured off the mesh.
  # Centreline front profile to hit (y: z):
  #     0.86: 0.051   0.82: 0.127   0.78: 0.184   0.76: 0.186   0.74: 0.177
  # and the plan view at y 0.76, half-width by z:
  #     z 0.02-0.05: 0.090   0.08-0.11: 0.075   0.14-0.17: 0.050   tip: 0.029
  # Root (0, 0.781, -0.037) with r 0.085 is the whole muzzle base — its back
  # is 85 mm inside the cranium, its x-reach 0.119 matches the skull's 0.116
  # at that height, so it fairs in with no crease. Tip (0, 0.765, 0.155) with
  # r2 0.030 puts the front at 0.185. No bend: the mesh top line is straight
  # from the brow to a blunt end. No nose: the cone just stops, as the mesh
  # does — every "round nose" this character ever had was a tip sphere
  # smaller than the taper wanted.
  blob head on skull at=0.00 r=0.085 r2=0.030 wide=1.40 tall=1.00 blend=0.0060 offset=(0,-0.026,0.029) tip=(0,-0.016,0.192)

  # THE POUT — a small lip under the snout's far end, set well back from
  # the nose tip (both new references agree: the mouth is NOT at the tip).
  # Base at y 0.685 z 0.155, its top blending into the snout's underside
  # (the curve there runs y ~0.71 with radius ~0.02), its front 26 mm
  # behind the nose. `chamfer` keeps the crease between lip and muzzle so
  # it reads as a mouth and not a sagging dewlap.
  # THE LIPS, and the owner's third note: "there are no big lips". At r 0.020
  # x wide 1.35 this was 0.027 of x-semi — a bead. Both new plates show a wide
  # protruding band under the muzzle, near as broad as the muzzle's own root
  # and clearly proud of it, and it is most of what makes the face read as
  # THIS character rather than as a generic mouse. r 0.032 x wide 2.10 puts it
  # at 0.067, a shade wider than the snout root's 0.064, sitting proud rather
  # than tucked underneath.
  # ============================================================
  # THE SUNGLASSES — geometry, painted. In the reference mesh they are not
  # a separate object: a glossy black bump on the face: two lens lobes, a thin
  # bridge, and two temple arms rising to the ears. Measured off the mesh by its PAINT
  # (black texels on the head, frame-aligned): the black region spans y
  # 0.86..0.92 and x +/-0.099 at the lenses, whose front reaches z 0.126..
  # 0.129 at x +/-0.03..0.07 against a skin front of ~0.115 there and 0.095
  # at x 0.09 — domes 14 mm proud in the middle and 24 mm at their outer
  # edge — dipping to a thin 0.116 bridge at x 0..0.02. Above the lenses the
  # black is two temple arms (see below), not a brow.
  #
  # `color=101012` is the mesh's lens black; gloss 0.95 gives the wet glint
  # the reference has. blend 0.002: a lens sits ON skin with a crisp edge,
  # and the paint boundary is the nearest-primitive boundary, so a fillet
  # here would smear yellow up the lens rim.
  # ============================================================
  # Lenses: BENT CAPSULES that wrap the cheek, not ellipsoids. A flat lens
  # floats: our face recedes to z 0.070 at x 0.10 (the mesh cheek is 0.095
  # there), so an ellipsoid spanning to x 0.100 left its outer tip 36 mm off
  # the skin. This one runs from (0.040, 0.885, 0.102) out to
  # (0.072, 0.885, 0.081) — the INNER end at 0.040, not at the centreline,
  # because the round cap adds r 0.028 and the mesh lens lobe starts at
  # x 0.02 with a thin bridge across the last 2 cm; with the axis at 0.004
  # the two caps met and the owner saw one black slab with no bridge — the AXIS ends at 0.072 because the capsule's
  # round cap adds r 0.028 beyond it, and the mesh lens stops at x 0.099 rim
  # included; a first cut ended the axis at 0.100 and the cap floated 20 mm
  # off the receding temple, 46 rays of daylight. Bent forward so the apex
  # sits at z 0.113; deep 0.55 makes it 15 mm thick, so the front reaches
  # ~0.128 mid-lens (mesh 0.129), ~0.121 at the bridge ends (0.120), and the
  # back is 5-18 mm inside the skin along its whole length. r 0.028 is the
  # lens band's half-height: y 0.857..0.913.
  blob head on skull at=0.00 r=0.028 wide=1.00 tall=1.00 deep=0.55 blend=0.0020 offset=(0.040,0.068,0.110) tip=(0.032,0,-0.021) bend=(0,0,0.028) both color=101012 gloss=0.95
  # Bridge: THIN. The paint at x 0..0.02 is an 8 mm sliver at z 0.108..0.116,
  # set back from the lobes (0.122..0.129) — a wire between two lenses, not
  # a third lens. One bar, r 0.008, from x -0.018 to +0.018, overlapping
  # both caps by 6 mm.
  blob head on skull at=0.00 r=0.008 wide=1.00 tall=0.75 deep=0.80 blend=0.0020 offset=(-0.018,0.068,0.116) tip=(0.036,0,0) color=101012 gloss=0.95
  # TEMPLE ARMS, not a brow. The black above the lenses summarised as
  # "x -0.089..0.094 per row" and got authored as one band — the owner's
  # unibrow. Split by side it is two columns: on the right, x 0.055..0.094
  # at every row from y 0.92 up, with z falling from 0.085 (0.92) to
  # 0.015..0.058 (0.97..0.98). An arm rising from the lens's outer corner
  # (0.088, 0.905, 0.084) up and back to (0.064, 0.985, 0.030) — the start
  # 11 mm further back than first cut, which had it floating 6-10 mm off
  # the temple for its first 3 cm, where it is
  # buried in the ear plate's inner rim — the arm goes to the ear, as arms
  # do. r 0.010 for the 2-3 cm of paint width. Seated: 5 mm proud of the
  # temple at its start, inside the skull at its end.
  blob head on skull at=0.00 r=0.010 wide=1.00 tall=1.00 blend=0.0020 offset=(0.088,0.088,0.092) tip=(-0.024,0.080,-0.054) both color=101012 gloss=0.60

  # THE LOWER FACE — the mass the lips sit IN, not in front of. The mesh at
  # y 0.70 is one body 0.21 deep (z -0.095..0.119) and 0.061 half-wide; at
  # 0.74 it is 0.158 half-deep and 0.091 wide. A jaw ellipsoid alone cannot
  # be that: it thins to 24 mm of depth at x +/-0.055, exactly where the lips
  # still reach, and a 48 mm void sat behind every lip corner (28 rays on a
  # 5 mm grid — the centreline saw none of it). This ellipsoid, centred at
  # (0, 0.715, 0.012) with half-extents 0.075 / 0.045 / 0.095, reaches back
  # to -0.083 (mesh -0.095) and forward to 0.107 at the mouth notch (mesh
  # 0.116), spans y 0.67..0.76, and at the lip corners covers z -0.05..0.08 —
  # the lips' back face at 0.054 is inside it at every x (tall 0.68 so it
  # also reaches under the lips' lower corners, the last 8 slivers). The lips still read
  # because their front, 0.121, stands 15 mm proud of this.
  blob head on skull at=0.00 r=0.075 wide=1.00 tall=0.68 deep=1.27 blend=0.0060 offset=(0,-0.092,0.078)

  # THE LIPS, from the mesh: a forward shelf under the snout at y 0.68-0.71,
  # front z 0.112-0.119, half-width 0.061, with the mouth line the notch at
  # y 0.72 where the front drops to 0.116 between them and the snout above.
  # Centre (0, 0.695, 0.074), r 0.038 x wide 1.6 x tall 0.7 -> front 0.112,
  # half-width 0.055 (the mesh is 0.061 at 0.70 and 0.039 at 0.68;
  # wider lips put their lower corners outside the lower face), y 0.675..0.725. The BACK face at z 0.036 sits
  # 7 mm inside the jaw ellipsoid's front (0.043 at that height, which is what
  # jawJut is set for) — attached by overlap, not by blend. The old lips sat
  # 14 mm above the snout's own axis and were simply swallowed.
  # deep 1.25 is for the CORNERS: at x +/-0.055 the jaw ellipsoid has narrowed
  # to the lips' own width, so with a round section the lips' outer ends only
  # grazed it and a 5 mm sliver of air sat behind each corner (44 rays on a
  # 5 mm grid). Deeper lips push the back face 9 mm further into the jaw at
  # every x, and the front lands at 0.121 against the mesh's 0.119.
  blob head on skull at=0.00 r=0.038 wide=1.45 tall=0.64 deep=1.25 blend=0.0030 chamfer offset=(0,-0.108,0.140)

  # THE MOUTH SEAM — a groove, not a gap. Cuts a channel where this flat
  # primitive's zero-set crosses the assembled pout: 5 mm across, biting
  # 4 mm in, running horizontally across the lip's front. `tall=0.08`
  # flattens the cutter vertically so the channel is a LINE.
  # The mouth seam, on the crease where the lips meet the snout's underside.
  groove head on skull at=0.00 r=0.040 wide=1.50 tall=0.08 deep=1.00 depth=0.005 width=0.006 offset=(0,-0.086,0.171)

  # ARMS AND LEGS — ONE FORM, not beads. The house ball-joint stylisation is
  # the goblin's look and the owner rejected it here: the reference limbs are
  # smooth rubber-hose tubes. The nubs are pulled in to shaft size and every
  # blend is opened up until the segment joints stop reading as lumps.
  # Spindly stays but NOT hair-thin: the reference's bare upper arm measures
  # 0.051 across and the forearm 0.044 — thicker than the 0.042/0.038 the
  # first pass used, which read as wire.
  # `core`: the shoulder ball is the arm's anchor against the torso; probing
  # from the upper-arm bar's midpoint instead grazed 7 mm of armpit air.
  blob arm on clavicle at=1.00 r=0.040 blend=0.0040 mirror core color=b1161f
  bar  arm on upperarm from=0.02 to=0.98 r=0.026 blend=0.0046 mirror color=b1161f
  # THE SLEEVE — the one part of the outfit with volume of its own. Every
  # other garment on the mesh is paint on the sculpt: the tee is the torso's
  # own 0.075 front and back, the shorts hug the legs. The sleeve is not: at
  # y 0.46..0.58 the red runs out to x 0.20 and stands 0.12 tall on an arm
  # 0.05 thick — a loose bell over the upper arm, ending at the elbow where
  # the bare forearm starts. One tapered bar along the upper arm, r 0.050 at
  # the shoulder to 0.042 at the mouth, over the 0.026 arm inside it.
  bar  arm on upperarm from=0.00 to=0.72 r=0.050 r2=0.042 blend=0.0050 mirror color=b1161f
  blob arm on forearm  at=0.00 r=0.025 blend=0.0046 mirror
  bar  arm on forearm  from=0.06 to=0.94 r=0.022 blend=0.0042 mirror
  blob arm on forearm  at=1.00 r=0.022 blend=0.0042 mirror

  # HAND: a paddle plus FOUR SPREAD FINGERS riding the finger bones above
  # (see the skeleton note for why they are bones and not tips). Hair-thin
  # tapered bars, 8 mm falling to 3 mm — cartoon fingers at 1.10 m, which is
  # the intent. The palm centres at hand t=0.35 so every finger base starts
  # INSIDE it and merges.
  # "THE TINY TINY HANDS" (owner, 2026-08-22). Measured off the mesh's
  # T-posed arm: the palm is 0.06 thick, 0.09 across the finger spread and
  # ~0.06 long, then four FAT fingers ~0.04 long and 0.02 thick — a mitt.
  # Ours was 0.051 across the spread with fingers tapering 8 mm -> 3 mm:
  # needles on a paddle. r 0.040 x (0.85, 1.0, 1.2) is 0.068 x 0.080 x
  # 0.096, and the fingers below are 0.012 -> 0.009, barely tapered.
  blob arm on hand at=0.35 r=0.040 wide=0.85 tall=1.00 deep=1.20 blend=0.0040 mirror
  bar  arm on f_index  from=0.00 to=0.92 r=0.012 r2=0.009 blend=0.0018 mirror
  bar  arm on f_middle from=0.00 to=0.92 r=0.012 r2=0.009 blend=0.0018 mirror
  bar  arm on f_ring   from=0.00 to=0.90 r=0.011 r2=0.008 blend=0.0018 mirror
  bar  arm on f_little from=0.00 to=0.88 r=0.010 r2=0.007 blend=0.0018 mirror

  # Mesh legs, y 0.16..0.24: each spans x 0.013..0.084, i.e. 0.071 across —
  # r 0.035, centred at x 0.048 — and they stay that width from shoe to
  # crotch. These were 0.020..0.026: wire. side 0.034 -> 0.042 on the thigh
  # bone moves the column out to match.
  blob leg on thigh at=0.00 r=0.038 blend=0.0050 mirror color=1d27a4
  # `core`: the leg's structural mass for the fuse probe — the shoe ball
  # below is fatter than anything in the leg and would otherwise be taken.
  bar  leg on thigh from=0.08 to=0.92 r=0.034 blend=0.0046 mirror core color=1d27a4
  blob leg on shin  at=0.00 r=0.034 blend=0.0048 mirror color=1d27a4
  # Split at the shorts' hem (mesh: y 0.19, 0.05 m below the knee). A prim is
  # one colour, so the paint boundary is a prim boundary: the top half of the
  # shin is shorts, 2 mm fatter for the hem's lip (mesh 0.083 against a
  # 0.071 leg), the bottom half bare.
  bar  leg on shin  from=0.08 to=0.50 r=0.034 blend=0.0044 mirror color=1d27a4
  bar  leg on shin  from=0.50 to=0.92 r=0.032 blend=0.0044 mirror
  blob leg on shin  at=1.00 r=0.032 blend=0.0046 mirror

  # Feet: swallowed by the kit's oversized shoes (topline 0.185), so all that
  # must be true of the flesh is that it fits INSIDE the shoe and fills the
  # toe. The ankle nub is the only part that shows above the topline.
  # ============================================================
  # THE SHOES — painted SDF, not kit. The mesh has no visible foot: the leg
  # enters a soft grey shoe at the ankle. Measured off the mesh by its
  # grey/white paint (right shoe, frame-aligned): heel 0.106 wide at
  # z -0.03, ball 0.147 wide at z 0.08..0.16, toe cap ending at z 0.18 and
  # lower than the body (ymax 0.09 against 0.10), 0.14 tall at the ankle
  # collar (x 0.019..0.107 at y 0.14, wrapping a leg centred at x 0.049),
  # and the long axis yawing only ~12 degrees outward — heel centre x 0.089
  # at z -0.02, toe centre x 0.130 at z 0.18. The kit lofts had 25 degrees
  # and a floating foot; the two-tube gap at the crotch and every
  # flesh-through-fabric fight came from dressing a smooth sculpt in hard
  # polygons. Three prims per side, mirrored by the leg limb:
  #   1. heel-to-toe cone, r 0.053 -> 0.046, the body of the shoe;
  #   2. the ball, a wider blob where the mesh is widest — tall 1.0 and
  #      centred at y 0.059, because at y 0.12 the mesh shoe is still 0.136
  #      wide and a flatter ball stopped 2 cm short (the silhouette's one
  #      "too narrow" band at 0.87 of height);
  #   3. the ankle collar, which is also what fuses the shoe to the shin.
  # Colour is the mean of the mesh's shoe paint; a little gloss for the
  # rubbery sheen in the plates.
  # ============================================================
  blob leg on foot at=0.00 r=0.053 r2=0.046 wide=1.00 tall=1.00 blend=0.0060 offset=(0.045,-0.088,0.018) tip=(0.041,-0.005,0.113) mirror color=b9b9bc gloss=0.25
  #   2. the ball, a wider blob where the mesh is widest, centred at y 0.059.
  #      wide 1.14 (mesh-iter 2026-08-22, was 1.18): at 1.18 the ball's
  #      shoulder flared to 0.170 of half-width at y 0.104 and band 0.90 read
  #      +0.026 vs the mesh — the mesh shoe widens GRADUALLY below the ankle
  #      (0.244 -> 0.297 -> 0.334 of height across 3 bands), ours stepped out
  #      in one. The equator bands (0.91-0.99) lose only 0.005 each and stay
  #      inside tolerance; the ankle-side onset is the WALL prim's job now.
  blob leg on foot at=0.00 r=0.062 wide=1.15 tall=0.85 deep=1.10 blend=0.0080 offset=(0.076,-0.082,0.100) mirror color=b9b9bc gloss=0.25
  #   2b. the WALL — the shoe upper's side, a flattened tapered capsule from
  #       the ankle down-and-out to the ball. No sphere can be this: the mesh
  #       outer edge runs 0.101@y0.147 -> 0.121@0.130 -> 0.132@0.122 ->
  #       0.150@0.113 -> 0.161@0.104 per side (a steepening curve), while a
  #       sphere is either fat high up (tall 1.0: band 0.88 +0.045) or absent
  #       (tall 0.9: band 0.88 -0.039) with nothing in between — the onset
  #       cliff always lands inside one band. A capsule's silhouette edge is
  #       a straight line, which hugs that curve to <0.01 everywhere.
  #       World axis A (0.076, 0.126, 0.055) -> B (0.124, 0.090, 0.082),
  #       r 0.045 -> 0.048, as PLAIN world displacements: a scaled prim's
  #       world shape is an ellipsoid centred on its raw world endpoint with
  #       radii scale*r, so offset/tip need NO scale compensation (the first
  #       attempt divided/multiplied them and put the axis at the knee / the
  #       floor). tall 0.40 keeps the top cap under the collar (band 0.87
  #       +0.001); deep 1.30 spans z -0.01..0.15 so the wall reads heel to
  #       toe. The thin y (r_y 0.018) is fine: below y 0.10 the wall is
  #       buried in the ball, only its side face shows.
  blob leg on foot at=0.00 r=0.045 r2=0.048 wide=1.00 tall=0.40 deep=1.30 blend=0.0060 offset=(0.032,-0.015,0.056) tip=(0.048,-0.036,0.027) mirror color=b9b9bc gloss=0.25
  blob leg on foot at=0.00 r=0.045 wide=1.00 tall=0.80 deep=1.10 blend=0.0070 offset=(0.019,-0.016,0.012) mirror color=b9b9bc gloss=0.25

# THE CRANIUM, measured off the reference mesh rather than guessed off a
# plate. At its widest row (y 0.86) the mesh skull is 0.135 half-wide and
# spans z -0.186..+0.051; the crown is at ~0.99 and the back of the skull
# runs down to the neck at y 0.70 (z -0.095). That is an ellipsoid of half
# extents 0.135 / ~0.145 / 0.118 centred at y 0.86, directly above the torso
# (the mesh's z -0.068 is its frame, not a lean — see the neck bone).
#
# No nose in the face params (noseLength under facePrims' 0.0005 gate), no
# brow ridge: the brows are black kit slabs.
face
  headRadius 0.131
  headWidth  1.03
  # 1.05: crown = 0.862 + 0.131*1.05 = 0.998, and the test holds the crown
  # under 1.0 so the ear discs own the standing height (mesh crown ~0.99).
  headHeight 1.05
  headDepth  0.93
  # THE JAW IS THE LOWER FACE. The mesh lower face is a wedge: half-width
  # 0.135 at 0.86, 0.091 at 0.74, 0.061 at 0.70, 0.039 at 0.68 — and it is
  # what bridges the cranium down to the neck (narrowing it without dropping
  # it has disconnected the head twice in this file's history). 0.88 x 0.66
  # gives 0.090 x 0.067 half-extents centred at y 0.745: 0.090 wide where the
  # mesh is 0.091, bottom at 0.678 where the mesh chin is.
  jawWidth   0.88
  jawHeight  0.66
  jawDrop    0.108
  # Forward 48 mm so the jaw's front at lip height (0.043) sits behind the
  # lips' back face (0.036) — the overlap the lips are attached by.
  jawJut     0.048
  noseLength 0.0004
  noseWidth  0.30
  noseDrop   0.010
  browHeavy  0.0004
  browRise   0.030
  headBlend  0.0050

# The mouse's own face sheet. The SHADES (kit) cover the eye line at y 0.749,
# so the painted eyes are small and dark — nothing should peek around the
# lenses. No painted mouth: the groove in the pout is the mouth, and a
# painted one would double it. Mostly this sheet is grain and jaw shading.
sheet
  eyeGap     0.42
  eyeSize    0.048
  eyeRise    0.39
  eyeTilt    0
  eyeSquash  1.20
  # 0, not a pupil — hidden behind the shades anyway.
  eyePupil   0
  # Zero: the brows are GEOMETRY (black kit slabs at the hairline). A painted
  # brow under them would show as a dark halo at the wrong height.
  browHeavy  0.0
  browAngle  0
  # Painted mouth OFF — the groove owns the seam. Width 0 draws nothing.
  mouthWidth 0.0
  mouthRise  0.70
  mouthCurve 0.0
  mouthOpen  0.0
  # No nostrils in the reference — the pout is blank yellow.
  nostril    0.0
  noseRidge  0.0
  noseWide   0.0
  noseLong   0.0
  jawShade   0.35
  # Toy-smooth, like the clown: stage-prop skin, not rotting flesh.
  grain      0.06
  seed       11

# BRIGHT TOY YELLOW, read off the reference's lit skin (sRGB 253,247,8). The
# first pass carried 0.86/0.78/0.008, which the output sRGB encode rendered
# as a mustard tone a shade duller than the image; the reference is a light
# near-lemon yellow, so the base goes to 1.00/0.93/0.010. Linear RGB, and it
# goes through the sRGB encode on the WebGPU path which lifts low channels —
# that is why blue sits at 0.010 rather than 0.
palette
  baseColor     1.00 0.93 0.010
  # Wounds stay red, as for every character.
  deepColor     0.50 0.08 0.08
  charColor     0.10 0.09 0.02
  specIntensity 0.40
  specRoughness 0.48
  fresnelBoost  0.35
  translucency  0.24
  # SMOOTH CLAY, the owner's second correction after the ears. surfaceNoiseAmp
  # perturbs the NORMAL (the warty micro-detail) and silhouetteNoiseAmp
  # perturbs the DISTANCE; both are ZERO for latex-smooth toy skin. An earlier
  # run concluded the palette could not touch these — false: compilePalette
  # accepts ANY FleshMaterial key. Pinned in mouse-blob.test.ts.
  surfaceNoiseAmp    0.0
  silhouetteNoiseAmp 0.0
  wetness       0.18
  # Very low: the reference skin is a flat, even yellow with no blotching at
  # all — this stays only so the body is not one dead tone under the key.
  # Raising it shifts the mean toward mottleColor (dark orange), so the base
  # is set bright to compensate.
  mottleAmp     0.06
  mottleScale   1.4
  mottleColor   0.72 0.52 0.03
