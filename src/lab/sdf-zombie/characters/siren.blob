# THE SIREN — the roster's first deliberately BEAUTIFUL body, and a lure.
# Owner brief (2026-10-23): every SDF character so far reads monstrous; make
# one that reads ATTRACTIVE — smooth surfaces, pleasant features, long hair —
# and keep her in a horror roster by letting the monster out only IN MOTION
# (owner pick: "lure, reveals in motion"; long loose DARK hair; the face is
# ours to draw — no reference mesh or plate, so blob:measure / blob:rings
# exit 2 and every number below is a design decision with its reason).
#
# WHO SHE IS. A tall, pale-warm woman in a crimson slip dress with dark hair
# to her waist, standing still in the carriage aisle. Nothing about her is
# wrong until she is within arm's reach: then her jaw drops past anything a
# jaw can do and a mouth of fangs opens out of the pretty face (the bride's
# jaw hinge, jaw.ts, opened far wider by her swing: motion-profile.ts
# SIREN_PROFILE.swingGape).
#
# THE LEVERS, set the OPPOSITE way to the monsters (biomech-style.md,
# "Attractive characters"):
#   1. THE FACE. Shaped by a few UNPAINTED prims (cranium, a face mass
#      tapering to a pointed chin, cheeks, carved eye sockets, a nose ridge,
#      lip swells) and coloured entirely by a generated sheet
#      (scripts/make-siren-face.py: huge anime eyes and lashes, brows, lids,
#      blush, red lips), worn at MULTIPLY. No painted face prims, no glow,
#      no ZOMBIE_FLAT mask. (Owner, 2026-10-23: the first, realistic face
#      read as "very ... human"; a full anime remake overshot; this is the
#      realistic head with an anime face painted on it.)
#   2. THE SKIN. Warm, slightly translucent, near-zero corpse noise
#      (palette): no mottle, no grain, no veins, no normal map.
#   3. THE SURFACES. Few long tapered prims with generous blends — one bar
#      per limb segment, so no seams, rings or lumps.
#   4. THE PROPORTIONS. The bride's elegant frame (her skeleton, verbatim):
#      a high hip line (legs ~57% of her height), a long neck, a small head,
#      a defined waist.
#   5. THE HAIR. A symmetrical orange flapper bob with spit curls (owner,
#      2026-10-24); earlier a bouffant, twin tails, a long fall, blue buns,
#      before that
#      waist-length, loose and dark: a crown mass plus strand
#      curtains framing the face, over the shoulders and down the back.
model siren
  # Flesh crown ~1.77 (the bride's skeleton, neck 4 cm shorter); the hair's
  # crown takes her to ~1.81.
  height 1.81
  stance humanoid

skeleton
  # THE BRIDE'S SKELETON, VERBATIM (bride.blob explains every number). Kept
  # whole for three reasons: it is gait-mappable as is (the zombie's gait
  # walks it), its proportions are already the elegant ones the brief asks
  # for (hip joint at 1.04 m, 57% of her height; a 0.14 m neck), and its jaw
  # bone + hinge are already solved, so the reveal costs no new rig.
  root pelvis at 0.96 len=0.08

  # Upright and a little proud: the lumbar sways back 2, the chest lifts.
  bone spine1 parent=pelvis dir=up pitch=-2 len=0.15
  bone chest  parent=spine1 dir=up pitch=-3 len=0.17
  bone spine2 parent=chest  dir=up pitch=0  len=0.07
  # The neck, pitched forward so the head floats ahead of the shoulders.
  # 0.10 m (owner, 2026-10-24: "her neck is a bit too long"; the bride's
  # 0.14 was her deliberately-wrong stalk).
  bone neck   parent=spine2 dir=up pitch=8  len=0.10
  # Skull tipped back 4 so the face lifts and the chin leads.
  bone skull  parent=neck   dir=up pitch=-4 len=0.24
  # The hem pendulum (the cultist's road): the dress's skirt rides it
  # `rigid`, so it lags the walk and swings on a stop.
  bone hem    parent=pelvis dir=down len=0.40
  # THE JAW — the reveal. A carrier for one kinematic rig point at the chin;
  # `on jaw` prims rotate about jaw.ts's hinge (skull 0.30, the upper lip
  # line) by the gape. See bride.blob for the derivation.
  # hinge=0.32: at the lip line, which the face pass moved up 4.8 mm
  # (reference.md: a hinge above the lips swings the jaw back into the
  # throat, one below barely opens the mouth).
  bone jaw    parent=neck   dir=up pitch=66 len=0.070 hinge=0.32

  mirror
    # Narrow sloping shoulders (socket x ~0.15, y ~1.41).
    bone clavicle parent=spine2   side=0.020 dir=side tilt=-8 len=0.13
    # Arms long and slender, held a little out and the forearms FORWARD,
    # hands in front of the hips (owner, 2026-10-24: "her arms fuse into"
    # the thighs). Probed surface-to-surface: hanging at tilt 20 / 12, pitch
    # 2 / 10, the forearm ran 1 cm INTO the hip; splaying wider only moved
    # the hand to the hips' widest point. At 24 / 6 and 12 / 30 the arm
    # clears hip and skirt by 3.8 cm (~2% of height, the guide's daylight).
    bone upperarm parent=clavicle dir=down tilt=24 pitch=6 len=0.30
    # Symmetric (the bride's lenR= sword forearm dropped: she has no sword).
    bone forearm  parent=upperarm dir=down tilt=12 pitch=30 len=0.26
    bone hand     parent=forearm  dir=down pitch=8         len=0.08
    # LEGS: 0.49 + 0.48 from the hip at 1.04 lands the ankle at ~0.07.
    # Knees drawn in a whisper. side 0.105 (the bride's 0.085): the heavier
    # thighs need the room.
    bone thigh    parent=pelvis dir=down tilt=-1.5 pitch=2 side=0.105 len=0.49
    bone shin     parent=thigh  dir=down tilt=1.5  pitch=-1 len=0.48
    bone foot     parent=shin   dir=fwd                      len=0.13
  end

body
  # ============================================================
  # TORSO — THE BARE BODY (owner, 2026-10-23: "focus on body first without
  # attachments ... more like the venus character with the rear and chest,
  # though bigger and bustier, but without all the bumpy texture"). Venus's
  # masses (venus.blob: wide hips, a rear shelf, a heavy bust, thick
  # thighs) on this skeleton, pulled into an hourglass — hips ~0.21 half-
  # width over a ~0.10 waist — and smooth: no normal map, no rolls, no
  # cage-lumps, the palette's corpse noise off. The dress shells and the
  # bust's crimson paint are gone; clothing comes back as attachments later.
  # ============================================================
  # HIPS — half-width 0.128 x 1.26 = 0.16 at the hip line (the
  # thigh tops carry the line on out to ~0.21; at 0.21 here the hip stood
  # out as a shelf over the legs, a bell), a band
  # (tall 0.80) centred just under the hip joint, so the widest slice is the
  # top of the thighs.
  blob torso on pelvis at=0.30 offset=(0,0,-0.020) tip=(0,-0.120,0.030) r=0.124 r2=0.050 wide=1.20 tall=0.80 deep=0.74 blend=0.040 core
  # (A downward-tapering CONE, not a ball: r 0.128 at the hip line to 0.058
  # at the crotch, so the pelvis narrows into a V between the thighs. As an
  # ellipsoid the whole front from the underbust to the crotch read as one
  # round bulb with no belly and no groin. deep 0.74 and set 1.6 cm back:
  # at deep 0.84 its front stood 5 cm proud of the waist, a pot belly; at
  # 0.66 / 3 cm the thigh tops bulged either side of a deep cleft.)
  # THE BELLY MOUND (owner: "a more pronounced V and mound belly"): a round
  # swell peaking at y ~1.00, ~2.8 cm proud of the waist, in FRONT of the
  # thigh tops (which are set back and made shallower in LEGS), so the
  # belly reads as its own shape with the thighs falling away behind it in
  # a V, not two thigh lobes meeting in the middle.
  blob torso on spine1 at=0.00 offset=(0,-0.030,0.030) r=0.084 wide=1.20 tall=0.95 deep=0.72 blend=0.032
  # THE NAVEL (owner, 2026-10-23: "there's not a proper navel"): a groove
  # pit on the belly mound's upper slope, y 1.10 (the mound peaks at 1.00,
  # the waist narrows at 1.14). A tiny sphere (r 0.003, a little tall)
  # centred ON the probed surface (z 0.0746 at the centreline): the groove
  # cuts a channel where its surface crosses the body's, a 3 mm circle,
  # and width 0.0035 widens that to fill the disc, so it reads as a pit,
  # 5 mm deep, not a ring. Grooves work on the torso; carves are head-only.
  groove torso on spine1 at=0.40 offset=(0,0,0.0767) r=0.0030 tall=1.50 depth=0.005 width=0.0035
  # THE REAR — two round mounds behind and a little below the hips (venus's
  # shelf, smaller and higher): back reach z ~-0.20, a cleft between them.
  blob torso on pelvis at=0.10 offset=(0.070,-0.010,-0.080) r=0.108 wide=1.00 tall=1.00 deep=1.00 blend=0.028 both
  # WAIST — pulled in hard over the hips: half-width ~0.10 at y ~1.13, a
  # flat belly (deep 0.78).
  bar  torso on spine1 from=0.15 to=1.00 r=0.080 r2=0.074 wide=1.20 deep=0.78 blend=0.030
  # RIBCAGE — wider at the top than the waist, the base the bust sits on.
  bar  torso on chest  from=0.00 to=0.88 r=0.080 r2=0.104 wide=1.18 deep=0.84 blend=0.028
  # THE BUST — big and round, set a little apart (x 0.076) and high: cones
  # from r 0.080 to 0.068 (0.088 read as two balls stuck on), blend 0.030 so
  # they grow out of the chest, tipped DOWN and forward a little, so they sit full
  # and heavy on the ribcage (venus's droop halved: hers sag, these lift).
  # Front reach z ~0.19 at y ~1.29.
  blob torso on chest  at=0.66 offset=(0.072,0,0.072) tip=(0.010,-0.045,0.035) r=0.080 r2=0.068 wide=1.00 deep=0.92 blend=0.030 both
  # Yoke + shoulder line, thin front-to-back.
  blob torso on spine2 at=0.90 r=0.060 wide=2.35 tall=0.62 deep=0.85 blend=0.034

  # ============================================================
  # THE CLOTHES (owner, 2026-10-24: "a bustier and skirt ... mesh or sdf,
  # I'll let you decide"). SDF SHELLS — thin real cloth standing a few mm
  # off the body (the bride's road), not paint on the skin: the skirt rides
  # the hem pendulum, and there is no Blender round-trip. Crimson satin
  # (8e0e1c). Every size is FITTED to the probed body cross-sections
  # (half-width x, front and back z, chest to knee, arms removed), so no
  # skin pokes through; the numbers in each comment are those probes.
  # ============================================================
  # THE BUSTIER CUPS: each breast's own cone (the bust prim above) grown
  # 6 mm, a shell cut straight across at the neckline (keeps y < 1.31), so
  # the upper bust shows over a firm edge (rim) and the cleavage is skin.
  shell torso on chest at=0.66 offset=(0.072,0,0.072) tip=(0.010,-0.045,0.035) r=0.086 r2=0.074 deep=0.92 thick=0.004 clip=(0,1,0) clipd=1.310 rim=0.004 blend=0.006 both color=8e0e1c gloss=0.60
  # THE BODICE: a cone from the waist (y 1.12; body x 0.114, z +-0.074)
  # widening to under the bust (y 1.24), cut at y 1.235 where the cups
  # take over. Fine vertical ribs (warp, no y frequency) read as boning.
  shell torso on spine1 at=0.53 offset=(0,0,-0.003) tip=(0,0.120,0.004) r=0.080 r2=0.092 wide=1.42 deep=0.98 thick=0.004 clip=(0,1,0) clipd=1.235 rim=0.004 blend=0.006 color=8e0e1c gloss=0.60 warp=0.0012 warpFreq=(140,0,140)
  # THE SKIRT, UPPER: the hips swell out in a DOME just below the waist
  # (x 0.108 / 0.160 / 0.202 / 0.228 at y 1.12 / 1.08 / 1.04 / 0.96 since the
  # thighs were narrowed, 2026-10-24), which
  # no cone follows (a straight one cut under it by 3 cm). An ELLIPSOID
  # centred at the hips' widest (y 0.95) has that dome: semi 0.241 x 0.193 x
  # 0.162, set back to z -0.034 for the rear (front 0.100 / back -0.186 at
  # 0.96); its top closes inside the waist at ~1.13, so the skirt grows out
  # of the waist without a band. On the pelvis: it moves with the hips.
  # Cut low (y 0.84), not at the seam: below 0.95 the ellipsoid narrows
  # faster than the pencil and sinks inside it, so the two meet in a blend,
  # not an edge (cut at 0.92 it left a ledge round the hips).
  shell torso on pelvis at=0.0 offset=(0,-0.010,-0.034) r=0.165 wide=1.46 tall=1.17 deep=0.98 thick=0.004 clip=(0,-1,0) clipd=-0.840 rim=0.002 blend=0.006 color=8e0e1c gloss=0.60
  # THE SKIRT, LOWER: a pencil cone from the hips (y 0.95; x 0.244, z
  # 0.144) tapering to a hem above the knee (y 0.71; x 0.181; body 0.161),
  # on the HEM pendulum so it swings with the walk.
  shell torso on hem at=0.0 offset=(0,-0.090,-0.040) tip=(0,-0.250,0.036) r=0.165 r2=0.122 wide=1.48 deep=0.87 thick=0.004 clip=(0,-1,0) clipd=-0.710 rim=0.006 blend=0.006 color=8e0e1c gloss=0.60 rigid

  # ============================================================
  # NECK + HEAD. The bride's solved head structure (bride.blob, "HEAD +
  # NECK": skull bone (0,1.568,0.005) -> (0,1.808,-0.011)), softened: no
  # bruised sockets, no corpse sheet, eyes of normal size and set, a rosy
  # mouth.
  # ============================================================
  # Long neck, flaring into the shoulders.
  bar  head on neck from=0.00 to=1.00 r=0.043 r2=0.034 deep=1.05 blend=0.028
  # CRANIUM: a human braincase, centre (0, 1.722, -0.011).
  blob head on skull at=0.64 offset=(0,0.0008,-0.0053) r=0.094 wide=0.755 tall=0.97 deep=0.96 blend=0.010
  # FACE MASS, split at the mouth (bride Task 12): the upper part on the
  # skull, the lower on the JAW, on one line with one taper, so at rest they
  # read as one smooth face and the jaw part swings away on the gape.
  # Blends 0.012, the bride's. 0.020 / 0.022 were tried to soften the
  # crease under the nose, and the smooth-min swell they stacked up with
  # the lips and jaw pushed the whole mouth area ~1 cm out of the face (the
  # surface sat 8-16 mm outside every prim there): a muzzle. The crease is
  # handled by removing the nose tip and the sheet's counter-light instead.
  blob head on skull at=0.45 offset=(0,0,0.0290) tip=(0,-0.0200,0.0040) r=0.054 r2=0.0360 wide=0.98 blend=0.012
  # PHILTRUM PAD: fills the 2 mm groove where the upper face mass's bottom
  # rim met the lips and jaw (probed at x 0.022: z 0.0751 / 0.0727 / 0.0744
  # at y 1.655 / 1.650 / 1.645), whose lit lower edge read as a pale crease
  # from cheek to cheek under the nose. On the skull and above the lip line
  # (centre y 1.652, bottom ~1.644), so it stays with the upper face when
  # the jaw drops.
  blob head on skull at=0.38 offset=(0,-0.0073,0.0640) r=0.014 wide=2.10 tall=0.55 deep=0.80 blend=0.010
  blob head on jaw at=1.0 offset=(0,0.01700,-0.02254) tip=(0,-0.0090,-0.0030) r=0.0270 r2=0.0230 wide=1.00 blend=0.012
  # THE MOUTH'S INSIDE — wet dark red, buried under the rest face (it paints
  # nothing at rest), filling the opening when the jaw drops.
  bar  head on skull from=0.28 to=0.19 offset=(0,0.0006,0.0460) r=0.011 wide=1.7 deep=0.9 blend=0.004 color=4e0a10 gloss=0.85
  # Slim jaw mass, set back from the face plane. wide 0.96 (bride 1.08)
  # and the lower face mass below at 1.08 / r2 0.028 (bride 1.20 / 0.030):
  # her jaw read square in the close-up; a taper to the chin is the heart-
  # shaped face.
  blob head on skull at=0.26 offset=(0,-0.0005,-0.0070) r=0.046 wide=0.84 tall=0.75 blend=0.012
  # Chin: small and soft, on the jaw, lifted 2.5 mm (the bride's long
  # chin read as a long lower face).
  blob head on jaw at=1.0 offset=(0,0.0200,-0.0090) r=0.008 wide=0.85 tall=0.95 blend=0.010
  # NO CHEEKBONE PRIMS. The bride's pair (and her lids and brow ridges)
  # sat at eye level and, on a face without her bruised sockets, read as
  # one horizontal band across the eyes: goggles (first look, 2026-10-23).
  # Beauty here is the smooth egg; the sheet paints the rest.
  # Soft cheeks — youth reads as fullness here, but at r 0.024 / x 0.036
  # the close-up read jowly; r 0.021 at x 0.034 keeps the curve, not the
  # bulge.
  blob head on skull at=0.50 offset=(0.040,-0.0085,0.0440) r=0.017 blend=0.014 both
  # EYES: an UNPAINTED eyeball bulge per eye — the shape the lids wrap
  # round — and ALL the colour on the sheet (make-siren-face.py: sclera,
  # iris, liner, lashes). The first passes painted sclera, iris and a
  # lash-line bar as prims (the bride's road), and a painted prim owns every
  # surface point it is NEAREST to: the off-white spread across the lids
  # and swallowed the lashes, two white saucers, a stare. Centred x 0.029,
  # 2.8 cm long (ordinary size and set; the bride's larger, wider-set eyes
  # were her deliberately-wrong doll trace), ~3 mm proud of the face.
  # DEEP SOCKETS (owner, 2026-10-23: "make the eye sockets deeper"): a
  # soft carve per eye, centred on the painted eye (x 0.031, rel the
  # cranium -27 mm), semi-axes 21 x 16 mm, recessing the eye ~7 mm and
  # easing out over the brow and cheek, so the brow and cheek stand over
  # the eye and the painted lid reads as set IN the head. wide 1.05, not
  # 1.30: at 1.30 the two carves met at the centreline and ate the nose
  # bridge flat. Smooth (blend 0.007): a crisp rim reads as a mask hole.
  carve on skull at=0.55 r=0.020 wide=0.90 tall=0.80 deep=0.75 blend=0.004 offset=(0.033,-0.0046,0.0975) both
  # No lid or brow-ridge prims (see the cheekbone note): with them the eye
  # was a slit under a shelf. The sheet paints the lid and brows.
  # Nasal root: fills between the eyes so they sit IN the face.
  blob head on skull at=0.57 offset=(0,0.0005,0.0720) r=0.010 wide=0.90 blend=0.006
  # THE NOSE: one soft ridge, no tip ball. Every tip tried (the bride's
  # r 0.0075, then 0.0054, 0.0044, 0.0032) stood over an undercut the
  # shading filled black — a dark cave ~1.5 cm wide under the nose, the
  # biggest thing in the close-up; a fill under it cast a moustache. The
  # anime faces she is pushed toward (owner, 2026-10-23) barely draw a nose.
  # The sheet paints a counter-light where the undercut was
  # (make-siren-face.py nose_light()). Projecting more (owner, 2026-10-24:
  # "her nose should project more"): the ridge's end pushed 8 mm further
  # out (tip z +0.009, was +0.001) and a touch fuller (r2 0.0046), still
  # one tapered ridge, no ball.
  blob head on skull at=0.53 offset=(0,0.0010,0.0860) tip=(0,-0.022,0.009) r=0.0034 r2=0.0046 blend=0.008
  # LIPS: a cupid's-bow upper on the skull and a fuller lower on the JAW,
  # so the mouth opens between them. SHAPE ONLY, and SUBTLE: their colour
  # is the sheet's (make-siren-face.py lips(), placed on THESE prims'
  # probed bumps: upper peak y rel the cranium -81.5 mm, lower -93 mm,
  # mouth line -86.2 mm). Painted, in any colour, a lip prim owns a band of
  # skin round it (paint is by NEAREST prim): a wax mouth 1.7 cm tall.
  # Brought 3 mm proud they only pushed out a muzzle through the face
  # blends, so they stay ~2 mm under the skin as soft swells. Bigger than
  # the first pass (r 0.0042 / 0.0056, 3.2 / 2.8 cm) for fuller lips.
  bar  head on skull from=0.32 to=0.32 offset=(-0.0135,0.0004,0.0720) tip=(0.027,0,0) bend=(0,0.0022,0.005) r=0.0042 tall=0.85 blend=0.004
  bar  head on jaw from=1.0 to=1.0 offset=(-0.0100,0.03838,0.00200) tip=(0.020,0,0) bend=(0,-0.0018,0.004) r=0.0048 tall=0.65 deep=0.70 blend=0.004 color=8c1220 gloss=0.40

  # ---- THE FANGS (the reveal): needle teeth hidden INSIDE the rest face
  # (the jaw capsule fills the mouth at rest; every tooth sits deep enough
  # under its front that it is never the NEAREST prim to the skin, so the
  # rest face shows nothing — the lower row was pushed 6 mm back when the
  # receded chin let it paint two ivory spots) and bared
  # only when the jaw drops. Upper row on the skull, hanging from the roof
  # of the mouth (1.2-1.9 cm: the compact, receded lower face leaves no
  # more room to hide them at rest); lower row on the jaw, standing up
  # from it. Ivory, wet.
  blob head on skull at=0.27 r=0.0042 r2=0.0007 offset=(-0.005,0.0000,0.0590) tip=(0.000,-0.019,0.003) blend=0.001 both color=e6dcc4 gloss=0.70
  blob head on skull at=0.27 r=0.0040 r2=0.0007 offset=(-0.012,0.0000,0.0570) tip=(0.000,-0.017,0.003) blend=0.001 both color=e6dcc4 gloss=0.70
  blob head on skull at=0.27 r=0.0036 r2=0.0006 offset=(-0.019,0.0000,0.0495) tip=(-0.001,-0.015,0.003) blend=0.001 both color=e6dcc4 gloss=0.70
  blob head on skull at=0.27 r=0.0032 r2=0.0006 offset=(-0.021,0.0000,0.0430) tip=(-0.001,-0.012,0.002) blend=0.001 both color=e6dcc4 gloss=0.70
  blob head on jaw at=1.0 r=0.0036 r2=0.0007 offset=(-0.008,0.0230,-0.0090) tip=(0.000,0.024,0.003) blend=0.001 both color=e6dcc4 gloss=0.70
  blob head on jaw at=1.0 r=0.0032 r2=0.0006 offset=(-0.016,0.0215,-0.0130) tip=(0.000,0.022,0.003) blend=0.001 both color=e6dcc4 gloss=0.70
  blob head on jaw at=1.0 r=0.0028 r2=0.0005 offset=(-0.020,0.0195,-0.0200) tip=(0.000,0.019,0.002) blend=0.001 both color=e6dcc4 gloss=0.70

  # ============================================================
  # HAIR — A FLAPPER BOB (owner, 2026-10-24: the bouffant "looks quite
  # asymmetrical ... maybe like a betty boop style stylized short haircut").
  # The 1930s cartoon flapper's archetype, not the character: SYMMETRICAL, a
  # centre part with a widow's peak, two rounded lobes on top, short at the
  # jaw, and little hooked spit curls round the edge. Orange (e8661c), a
  # satin gloss. Every mass keeps radius x largest scale under the cranium's
  # 0.0912, or the face sheet re-centres on the hair (headShape). Offsets
  # are from the skull's at=0.64 point (0, 1.7215, -0.0054).
  # ============================================================
  # The base: the hairline over the forehead's top (front reach z ~0.083 at
  # y ~1.74, ~4 cm above the brows). deep 0.98: under the cranium's size.
  blob head on skull at=0.64 offset=(0,0.0200,-0.0060) r=0.092 wide=0.86 tall=0.95 deep=0.98 blend=0.006 color=e8661c gloss=0.50
  # THE LOBES: two round domes either side of the part, so the top of the
  # head is a heart, the part a crease between them.
  blob head on skull at=0.64 offset=(0.040,0.066,-0.004) r=0.070 wide=0.95 tall=0.85 deep=1.10 blend=0.008 both color=e8661c gloss=0.50
  # THE WIDOW'S PEAK: the lobes' front edges meeting in a point on the
  # forehead's centre, a short tapered tongue down from the part.
  blob head on skull at=0.64 offset=(0,0.056,0.070) tip=(0,-0.040,0.010) r=0.020 r2=0.003 wide=1.40 deep=0.55 blend=0.006 color=e8661c gloss=0.50
  # THE SIDES: the bob's fullness over the ears, ending at the jaw (y ~1.64).
  blob head on skull at=0.64 offset=(0.072,-0.008,-0.012) r=0.056 wide=1.00 tall=1.40 deep=1.05 blend=0.010 both color=e8661c gloss=0.50
  # THE BACK: the bob carried round behind the head, cut at the nape.
  blob head on skull at=0.64 offset=(0,0.000,-0.066) r=0.076 wide=1.15 tall=1.10 deep=0.90 blend=0.010 color=e8661c gloss=0.50
  # SPIT CURLS: two flat commas lying ON the forehead either side of the
  # peak (deep 0.40, the tip curling down and out along the skin). Curls
  # standing out round the silhouette were tried twice and read as a
  # spiked mace in 3D: the cartoon's curls are drawn flat on the hair.
  blob head on skull at=0.64 offset=(0.026,0.040,0.078) tip=(0.014,-0.020,0.002) bend=(0.010,0.004,0.002) r=0.011 r2=0.004 deep=0.40 blend=0.004 both color=e8661c gloss=0.50
  # THE FLIP: the cut ends turned up and out at the jaw, a soft roll each
  # side, so the bob ends in a curl rather than a cut.
  blob head on skull at=0.64 offset=(0.084,-0.082,-0.006) tip=(0.026,0.008,0.004) bend=(0,0.008,0) r=0.022 r2=0.014 deep=1.00 blend=0.010 both color=e8661c gloss=0.50

  # ============================================================
  # ARMS — slim and smooth: one ball at the shoulder, one tapered bar per
  # segment, a slender hand. Blends 0.022-0.024 at the elbow (first pass
  # 0.014-0.016 left a ball joint there: a wooden doll).
  # ============================================================
  blob arm on upperarm at=0.06 r=0.036 blend=0.030 mirror core
  bar  arm on upperarm from=0.04 to=0.97 r=0.035 r2=0.026 blend=0.022 mirror
  bar  arm on forearm  from=0.00 to=0.96 r=0.027 r2=0.019 blend=0.024 mirror
  blob arm on hand     at=0.45 r=0.022 wide=0.75 tall=1.25 deep=1.10 blend=0.016 mirror

  # ============================================================
  # LEGS — venus's heavy thighs on long legs: a full root carrying the
  # hip's width down the outside of the thigh in one curve, tapering hard to
  # a slim knee, a soft calf, a slender bare foot. Set apart (side 0.105) so
  # the inner thighs meet without passing through each other.
  # ============================================================
  blob leg on thigh at=0.14 offset=(0.016,0,-0.024) r=0.082 tall=0.90 deep=0.85 blend=0.034 mirror core
  # from=0.16: started at the hip joint, its r 0.108 end cap rose to y
  # ~1.14 and swallowed the waist (the abdomen read as part of the hips).
  bar  leg on thigh from=0.16 to=1.05 offset=(0.004,0,-0.012) r=0.090 r2=0.043 wide=0.92 deep=0.92 blend=0.034 mirror
  # Outer thigh: venus's, smaller — the hip's line carried down the side.
  # at=0.20: its ends must bind within the thigh's own joint ring, or the
  # rig hands them to the pelvis (rig-bind.test.ts 'joint ring'). Which
  # (at, x) pairs pass is found by trying, not by rule: 0.24 / 0.022 failed
  # and 0.20 / 0.022 passes.
  blob leg on thigh at=0.20 offset=(0.022,-0.020,-0.016) r=0.074 tall=1.60 deep=0.90 blend=0.036 mirror
  # THE KNEE AND SHIN (owner, 2026-10-24: "still some issues with the
  # leg"). Probed, the leg narrowed to 104 mm at y 0.64 and then WIDENED to
  # 126 mm at the knee (0.56): the thigh's end, the shin's start and the
  # calf's start all met there, each with its own wide blend, and the swells
  # stacked into a ball; and the calf ended in an 18 mm step at y 0.26. Now
  # the shin starts SMALLER than the thigh ends (0.036 under 0.043) with a
  # modest blend, so the knee is one taper; the calf starts below the knee
  # and runs on down to the ankle, so its end is a taper too. Probed after:
  # 88-94 mm wide from the knee through the calf, no ball and no pinch.
  # THE KNEE: one soft stretched ellipsoid ON the joint. The thigh's
  # rounded end and the shin's rounded start sat side by side there and
  # left a groove between them, a ring from the side (CPU-shaded side view)
  # even once widths and fronts lined up; the thigh now runs 5% past the
  # knee (to=1.05) so the two ends overlap, and this fills what is left into
  # one kneecap curve.
  blob leg on shin  at=0.00 offset=(0,0,-0.008) r=0.038 tall=1.80 deep=1.00 blend=0.020 mirror
  # Set back 9 mm (offset z): the thigh bar is set back 12 mm and the shin
  # was not, so the front of the leg stepped 1 cm FORWARD at the knee — a
  # ring from the side even with the widths smooth.
  bar  leg on shin  from=0.02 to=0.96 offset=(0,0,-0.009) r=0.036 r2=0.021 blend=0.020 mirror
  # Calf: a long soft ELLIPSOID behind the shin, fullest a third of the way
  # down (no end caps: as a tapered cone its rounded top read as a second
  # band below the knee), fading out above the ankle.
  blob leg on shin  at=0.36 offset=(0,0,-0.014) r=0.036 tall=2.6 deep=1.05 blend=0.026 mirror
  # THE FOOT: a heel-to-toe shape, not a stick — a tapered drop from a
  # rounded heel under and behind the ankle to a slim toe ~13 cm forward,
  # the instep high, with the ankle a smooth fill between shin and foot.
  # (A thin bar of r 0.028 -> 0.018 read as a flat stick joined at an angle.)
  blob leg on foot  at=0.00 offset=(0,-0.048,-0.018) tip=(0,-0.010,0.140) r=0.030 r2=0.015 wide=1.20 tall=0.85 blend=0.016 mirror
  blob leg on foot  at=0.00 offset=(0,-0.020,0.004) r=0.026 wide=1.05 tall=1.10 blend=0.018 mirror

# Interior bones for wound reveals: the bride's.
bones
  ratio 0.38
  blob head on skull at=0.64 offset=(0,0.0008,-0.0053) r=0.076 wide=0.74 tall=0.92 deep=0.90
  bar  torso on spine1 from=0.00 to=1.00 r=0.024
  blob torso on chest  at=0.55 r=0.062 wide=1.25 tall=1.25 deep=0.85
  blob torso on pelvis at=0.30 r=0.080 wide=1.25 tall=0.80 deep=0.85

# The face block is a NUB (the bride's): every feature is a prim above, so
# the generated cranium/jaw/brow/nose stay out of the way.
face
  headRadius 0.001
  headWidth  1.0
  headHeight 1.0
  headDepth  1.0
  jawWidth   1.0
  jawHeight  1.0
  jawDrop    0
  jawJut     0
  noseLength 0
  noseWidth  1.0
  noseDrop   0
  browHeavy  0
  browRise   0
  headBlend  0.006

# THE PAINT: scripts/make-siren-face.py (eyes, brows, lids, liner, lashes,
# blush, lips — every colour on the face), worn at MULTIPLY so the face takes the body's light, with
# blendLuma 0 so the rose and mauve stay colours (multiply defaults to
# luminance only, which turns coloured paint grey). The projection is the
# bride's, which the painter's geometry is solved against: change one, change
# both. No glow anywhere: eyeGlowAmp 0, cut above every texel.
sheet
  image       siren-face.png
  decal       0
  blendLuma   0
  projScaleX  0.40
  projScaleY  0.40
  projCentreX 0.50
  projCentreY 0.70
  eyeGlowCut  0.99
  eyeGlowAmp  0
  # Low luminance relief (the bride's lesson: at the 1.4 default every thin
  # ink line, here every lash, embosses as a groove with a lit rim).
  texRelief   0.0

# WARM, LIVING SKIN — the opposite of every corpse palette in the roster.
# sRGB ~(236,200,182) -> linear; a peach glow through the ears and fingers
# (translucency 0.30), a soft broad sheen instead of a wet spec, and the
# corpse noise turned all the way down.
palette
  baseColor     0.82 0.58 0.47
  deepColor     0.50 0.06 0.07
  charColor     0.20 0.12 0.10
  specIntensity 0.32
  specRoughness 0.50
  fresnelBoost  0.30
  translucency  0.30
  wetness       0.08
  # ZERO noise (owner, 2026-10-23: "without all the bumpy texture"):
  # silhouetteNoiseAmp DISPLACES the surface (metres), and at 0.008 it
  # rippled the big smooth masses of the hips and thighs in bands.
  surfaceNoiseAmp    0
  silhouetteNoiseAmp 0
  mottleAmp     0.03
  mottleScale   1.2
  mottleColor   0.70 0.42 0.36
  grain         0
