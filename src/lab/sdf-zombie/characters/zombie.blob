# The lab zombie. Proportions are deliberately wrong in a B-movie way: long
# arms hanging past the hip line, head pitched forward of the spine, heavy gut.
model zombie
  height 1.78

skeleton
  root pelvis at 0.92

  # The upper body hunches FORWARD (+z). These used to lean -z while the
  # forearms angled +z, so in profile the occiput jutted where the face should
  # be and the head read as being on backwards.
  bone spine parent=pelvis dir=up pitch=6.842773 len=0.34
  bone neck  parent=spine  dir=up pitch=19.290046 len=0.16
  bone skull parent=neck   dir=up pitch=10.203974 len=0.16

  mirror
    bone clavicle parent=spine    dir=side                     len=0.20
    bone upperArm parent=clavicle dir=down tilt=16.699244      len=0.30
    bone foreArm  parent=upperArm dir=down tilt=2.862405 pitch=5.703515 len=0.30
    bone thigh    parent=pelvis   dir=down side=0.10           len=0.40
    bone shin     parent=thigh    dir=down pitch=2.862405      len=0.42
  end

body
  # Head — just the neck here. The skull itself is a parameterised ellipsoid
  # emitted by the face block, so it stays tunable in the panel.
  bar head on neck from=0.05 to=1.0 r=0.045 blend=0.007

  # Torso — ribcage tapering into a sagging gut.
  blob torso on spine  at=0.80 r=0.150 wide=1.28 deep=0.78 blend=0.014
  blob torso on spine  at=0.50 r=0.150 wide=1.15 deep=0.80 blend=0.02
  blob torso on spine  at=0.15 r=0.142 wide=1.02 deep=0.95 blend=0.02
  blob torso on pelvis at=0.40 r=0.145 wide=1.10 tall=0.9 deep=0.92 blend=0.02

  # Arms — shoulder blob, then upper and forearm capsules, then a fist.
  blob arm on clavicle at=0.90 r=0.072 blend=0.010 mirror
  bar  arm on upperArm from=0.02 to=0.95 r=0.055 blend=0.007 mirror
  bar  arm on foreArm  from=0.05 to=0.90 r=0.048 blend=0.007 mirror
  blob arm on foreArm  at=1.00 r=0.062 blend=0.0125 mirror

  # Legs — thigh, shin, foot.
  bar  leg on thigh from=0.05 to=0.95 r=0.082 blend=0.0175 mirror
  bar  leg on shin  from=0.05 to=0.92 r=0.062 blend=0.015 mirror
  blob leg on shin  at=1.00 r=0.070 wide=0.85 tall=0.6 deep=1.5 blend=0.0125 mirror

# Wound pass r2: hidden bone, revealed by a wound. Auto-derive (ratio 0.38)
# is right for limbs — a femur IS a thinner capsule inside the thigh — and
# wrong for the two places players actually shoot, which are authored here.
# The limb word is a REAL limb (head|torso|arm|leg), not "bone": the grammar
# has no `bone` limb, and the word is what gives the prim its cluster, i.e.
# which wounds can expose it.
bones
  ratio 0.38

  # SKULL — cranium + jaw.
  #
  # The first version was one blob at r=0.072 and the owner's read was "a
  # really small round ball, and there's no jaw of course" (playtest
  # 2026-09-02). It was small because it WAS small: the face block's head
  # ellipsoid has semi-axes ~(0.090, 0.137, 0.105), and a 0.072 sphere at 0.88/
  # 0.95/0.86 sits ~(0.063, 0.068, 0.062) — barely half the head it lives in,
  # so a headshot exposed a marble.
  blob head on skull at=0.56 r=0.086 wide=0.94 tall=1.06 deep=0.92
  # Jaw — dropped and jutted to follow the face block's own jaw (jawDrop 0.076,
  # jawJut 0.04). Separate from the cranium and hard-folded, so a blown-open
  # face reads as two bones meeting rather than one smooth helmet.
  blob head on skull at=0.30 offset=(0,-0.028,0.030) r=0.050 wide=0.82 tall=0.58 deep=0.96

  # TORSO SKELETON — ribcage, spine, clavicles, pelvis (re-authored 2026-09-03).
  #
  # Every line from here to GUT COIL is EMITTED by scripts/zombie-skeleton-gen.ts
  # (`npx tsx scripts/zombie-skeleton-gen.ts --check --write`), which holds the
  # anatomical parametrisation and checks each prim with the same boneBreach
  # sampler buildBody runs and rewrites the lines below the marker. Edit the
  # table there; the reasoning for every number lives in that file, and the
  # per-line comments below are its summary.
  #
  # What this replaced, and why (owner, bone-tubes review 2026-09-03: "the
  # ribcage structure seems way off"): six rib pairs spanning y 1.12-1.32 —
  # 20 cm of cage in a 34 cm spine — and ~12 cm across inside a torso 38 cm
  # wide. Each rib was ONE quadratic from spine to sternum with a 7 cm chord
  # and an 8 cm bulge, so it read as a rod radiating from the spine rather
  # than a hoop. No clavicles. The pelvis was two 7 cm blades and a basin.
  #
  # What is here now, per the owner's reference (a standard human torso):
  #  - SIX rib pairs (owner's second look: twelve read as too many; half,
  #    thicker), heads y 1.375 down to 1.165 at 4.2 cm pitch. Each rib is TWO
  #    bars meeting at the flank — back half vertebra -> rib angle -> flank,
  #    front half flank -> sternum (costal margin for 5-6) — because a bar is
  #    one quadratic Bezier and a hoop needs two. Upper ribs short and flat,
  #    4 widest (half-width 0.160 against a chest half-width of ~0.19), lower
  #    ribs shorter and angled down. r ~0.011 x tall=1.3: a fat band.
  #  - The spine is a kyphotic curve at the BACK (apex z -0.080, back skin is
  #    -0.134), not a rod up the rig axis: lumbar on the pelvis bone, thoracic
  #    split at its apex so each half is rigid with the joint its ribs bind to.
  #  - Sternum through the sternal ends of ribs 1-7; clavicles manubrium ->
  #    acromion, written `both` on the spine so they are TORSO bones.
  #  - Pelvis as a SOLID MASS (owner's second look: the fan of thin bars read
  #    as "doodly lines"): fat sacrum wedge; per side a thick iliac blade
  #    (r 0.030, flattened front-to-back) from the acetabular hub to the crest
  #    apex at x 0.128 y 1.100, a thick crest rim, and a fat pubic ring. The
  #    rig's hip joints sit at y 1.06, higher than a person's, so the wings
  #    flare only 4 cm above them — the cage/crest gap is what the rig allows.
  #
  # Idioms: `from=t to=t` puts both ends on ONE rig point, `offset=` moves the
  # start to where the bone actually is, `tip=` is the far end relative to the
  # start, `bend=` bows the chord (curve midpoint = chord midpoint + bend/2).
  #
  # Constraints that shaped the numbers:
  #  - checkBoneContainment, 4 mm: the cage's back is FLATTER than anatomy
  #    (rib-angle offset 0.012, half-depths trimmed on ribs 4-10) because the
  #    zombie's back is a blended ellipsoid, rounder than a person's, and the
  #    back-flank corner of ribs 6-10 was the first thing to breach.
  #  - rig-bind.ts poses torso bones as ONE rigid frame per axial segment
  #    (spine / pelvis): rotation + translation from the segment's two rig
  #    points. Point-binding carried no rotation, so the cage sheared into an
  #    upper and a lower half whenever the spine tilted (owner's second look).
  #  - MAX_PRIMS 128 counts flesh + bone. The bone instancer cap went
  #    512 -> 1024 for the cast.
  # ---- generated by scripts/zombie-skeleton-gen.ts; edit the table there, not these lines ----
  # Thoracic column, lower half (T12 -> apex of the kyphosis at y 1.245, z -0.08).
  bar torso on spine from=0.1 to=0.1 offset=(0,-0.0038,-0.0641) tip=(0,0.155,-0.02) bend=(0,0,-0.032) r=0.018 deep=0.85
  # Thoracic column, upper half (apex -> C7 at (0,1.40,0.028), meeting the derived neck bone).
  bar torso on spine from=0.9 to=0.9 offset=(0,-0.1192,-0.1169) tip=(0,0.155,0.108) bend=(0,0,-0.032) r=0.018 deep=0.85
  # Lumbar column: sacral promontory (0,1.00,-0.047) up to T12, bowed 1 cm forward (lordosis).
  bar torso on pelvis from=0.6 to=0.6 offset=(0,-0.004,-0.047) tip=(0,0.09,-0.013) bend=(0,0,0.02) r=0.018 deep=0.85
  # Rib 1: head y 1.375, cage half-width 0.075 / half-depth 0.05, descends 0.02 to the sternum. Back half: vertebra -> rib angle -> flank.
  bar torso on spine from=0.932 to=0.932 offset=(0.017,0,-0.0363) tip=(0.058,-0.0104,0.038) bend=(0.0255,0,-0.0105) r=0.0095 tall=1.3 both
  bar torso on spine from=0.932 to=0.932 offset=(0.075,-0.0104,0.0017) tip=(-0.051,-0.0096,0.0474) bend=(0.0229,0,0.0109) r=0.0095 r2=0.0078 tall=1.3 both
  # Rib 2: head y 1.333, cage half-width 0.125 / half-depth 0.082, descends 0.036 to the sternum. Back half: vertebra -> rib angle -> flank.
  bar torso on spine from=0.8077 to=0.8077 offset=(0.017,0,-0.0675) tip=(0.108,-0.0184,0.07) bend=(0.0464,0,-0.0141) r=0.0105 tall=1.3 both
  bar torso on spine from=0.8077 to=0.8077 offset=(0.125,-0.0184,0.0025) tip=(-0.101,-0.0176,0.0805) bend=(0.044,0,0.0238) r=0.0105 r2=0.0086 tall=1.3 both
  # Rib 3: head y 1.291, cage half-width 0.155 / half-depth 0.092, descends 0.05 to the sternum. Back half: vertebra -> rib angle -> flank.
  bar torso on spine from=0.6834 to=0.6834 offset=(0.017,0,-0.0893) tip=(0.138,-0.0254,0.08) bend=(0.0589,0,-0.0158) r=0.011 tall=1.3 both
  bar torso on spine from=0.6834 to=0.6834 offset=(0.155,-0.0254,-0.0093) tip=(-0.131,-0.0246,0.0909) bend=(0.0566,0,0.0287) r=0.011 r2=0.009 tall=1.3 both
  # Rib 4: head y 1.249, cage half-width 0.16 / half-depth 0.09, descends 0.058 to the sternum. Back half: vertebra -> rib angle -> flank.
  bar torso on spine from=0.5592 to=0.5592 offset=(0.017,0,-0.1017) tip=(0.143,-0.0294,0.078) bend=(0.061,0,-0.0159) r=0.011 tall=1.3 both
  bar torso on spine from=0.5592 to=0.5592 offset=(0.16,-0.0294,-0.0237) tip=(-0.136,-0.0286,0.089) bend=(0.0587,0,0.0284) r=0.011 r2=0.009 tall=1.3 both
  # Rib 5: head y 1.207, cage half-width 0.145 / half-depth 0.077, descends 0.06 to the costal margin. Back half: vertebra -> rib angle -> flank.
  bar torso on spine from=0.4349 to=0.4349 offset=(0.017,0,-0.1048) tip=(0.128,-0.0326,0.065) bend=(0.0547,0,-0.0148) r=0.0105 tall=1.3 both
  bar torso on spine from=0.4349 to=0.4349 offset=(0.145,-0.0326,-0.0398) tip=(-0.095,-0.0274,0.0723) bend=(0.0428,0,0.0159) r=0.0105 r2=0.0086 tall=1.3 both
  # Rib 6: head y 1.165, cage half-width 0.12 / half-depth 0.074, descends 0.052 to the costal margin. Back half: vertebra -> rib angle -> flank.
  bar torso on spine from=0.3107 to=0.3107 offset=(0.017,0,-0.0984) tip=(0.103,-0.0327,0.062) bend=(0.0443,0,-0.0136) r=0.0095 tall=1.3 both
  bar torso on spine from=0.3107 to=0.3107 offset=(0.12,-0.0327,-0.0364) tip=(-0.04,-0.0193,0.0552) bend=(0.0191,0,0.0053) r=0.0095 r2=0.0078 tall=1.3 both
  # Sternum: manubrium at y 1.372 down to the xiphoid at y 1.181, riding the ribs' sternal ends in z.
  bar torso on spine from=0.75 to=0.75 offset=(0,0.0585,0.0565) tip=(0,-0.191,0.0009) bend=(0,0,0.052) r=0.01 wide=2.4 deep=0.6
  # Clavicle: manubrium -> acromion, bowed forward through (0.105,1.392,0.052).
  bar torso on spine from=1 to=1 offset=(0.026,-0.026,0.0463) tip=(0.159,0.03,-0.0523) bend=(-0.001,0.01,-0.0183) r=0.0075 both
  # Sacrum: promontory (0,1.005,-0.047) curving back to z -0.070 then forward to the coccyx. Fat wedge, 48 mm across at the top.
  bar torso on pelvis from=0.5 to=0.5 offset=(0,0.015,-0.047) tip=(0,-0.08,0.011) bend=(0,0,-0.057) r=0.032 r2=0.016 wide=1.5 deep=0.7
  # Iliac blade: acetabular hub (0.078,1.045,-0.006) up and out to the crest apex (0.128,1.100,-0.014); r 0.030, flattened front-to-back.
  bar torso on pelvis from=0.5 to=0.5 offset=(0.078,0.055,-0.006) tip=(0.05,0.055,-0.008) r=0.03 deep=0.6 tall=1.1 both
  # Iliac crest: PSIS -> apex -> ASIS, the thick rim over the blade.
  bar torso on pelvis from=0.5 to=0.5 offset=(0.04,0.065,-0.07) tip=(0.078,0.015,0.12) bend=(0.098,0.075,-0.008) r=0.018 deep=0.8 both
  # Ilium back to the sacro-iliac joint.
  bar torso on pelvis from=0.5 to=0.5 offset=(0.078,0.055,-0.006) tip=(-0.038,0.01,-0.064) r=0.022 both
  # Pubic ring: superior ramus hub -> symphysis (0.014,0.935,0.056),
  bar torso on pelvis from=0.5 to=0.5 offset=(0.078,0.055,-0.006) tip=(-0.064,-0.11,0.062) r=0.018 both
  # ischium hub -> sit bone (0.056,0.905,-0.026), the fat lower mass,
  bar torso on pelvis from=0.5 to=0.5 offset=(0.078,0.055,-0.006) tip=(-0.022,-0.14,-0.02) r=0.022 both
  # ischiopubic ramus closing the ring underneath.
  bar torso on pelvis from=0.5 to=0.5 offset=(0.056,-0.085,-0.026) tip=(-0.042,0.03,0.082) r=0.015 both

  # GUT COIL (organs r3). Suggestive of the classic intestine look, not
  # anatomical — owner: "doesn't need to be anatomically correct, just
  # suggestive". The read is round tubes, visible loops, pale pink, wet.
  #
  # Only drawable since applyBones started reading bend (3dc8373); before
  # that every one of these would have rendered as a straight bar.
  bar torso on pelvis from=0.55 to=0.75 offset=(-0.045,0.010,0.030) tip=(0.090,0.010,0.006) bend=(0.010,0.055,0.030) r=0.024 organ
  bar torso on pelvis from=0.50 to=0.70 offset=(0.048,0.004,0.034) tip=(-0.092,0.014,-0.010) bend=(-0.012,-0.050,0.026) r=0.023 organ
  bar torso on pelvis from=0.72 to=0.92 offset=(-0.040,0.004,0.026) tip=(0.084,-0.008,-0.014) bend=(0.008,0.048,0.032) r=0.022 organ
  bar torso on spine  from=0.06 to=0.20 offset=(0.042,0.000,0.030) tip=(-0.086,-0.010,-0.008) bend=(-0.010,-0.044,0.028) r=0.022 organ
  # Segmented bulges: overlapping blobs at a tight blend read as haustra far
  # more cheaply than grooving a smooth tube.
  blob torso on pelvis at=0.62 offset=(-0.058,0.006,0.038) r=0.026 blend=0.004 organ
  blob torso on pelvis at=0.62 offset=(-0.020,0.014,0.042) r=0.025 blend=0.004 organ
  blob torso on pelvis at=0.62 offset=(0.020,0.010,0.042) r=0.025 blend=0.004 organ
  blob torso on pelvis at=0.62 offset=(0.058,0.002,0.038) r=0.026 blend=0.004 organ

# Tuned by hand in the panel, then baked. Keep headHeight near 1: raising it
# SHARPENS the crown rather than doming it, so the height and the gaunt taper
# both come from the jaw below.
face
  headRadius 0.118
  headWidth  0.76
  headHeight 1.161
  headDepth  0.894
  jawWidth   0.748
  jawHeight  0.861
  jawDrop    0.076
  jawJut     0.04
  noseLength 0.007
  noseWidth  0.379
  noseDrop   0.009
  browHeavy  0.008
  browRise   0.045
  headBlend  0.006
