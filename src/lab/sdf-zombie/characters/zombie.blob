# The lab zombie. Proportions are deliberately wrong in a B-movie way: long
# arms hanging past the hip line, head pitched forward of the spine, heavy gut.
model zombie
  height 1.78

skeleton
  root pelvis at 0.92

  # The upper body hunches FORWARD (+z). These used to lean -z while the
  # forearms angled +z, so in profile the occiput jutted where the face should
  # be and the head read as being on backwards.
  bone spine parent=pelvis dir=up pitch=6.842773 len=0.34
  bone neck  parent=spine  dir=up pitch=19.290046 len=0.16
  bone skull parent=neck   dir=up pitch=10.203974 len=0.16

  mirror
    bone clavicle parent=spine    dir=side                     len=0.20
    bone upperArm parent=clavicle dir=down tilt=16.699244      len=0.30
    bone foreArm  parent=upperArm dir=down tilt=2.862405 pitch=5.703515 len=0.30
    bone thigh    parent=pelvis   dir=down side=0.10           len=0.40
    bone shin     parent=thigh    dir=down pitch=2.862405      len=0.42
  end

body
  # Head — just the neck here. The skull itself is a parameterised ellipsoid
  # emitted by the face block, so it stays tunable in the panel.
  bar head on neck from=0.05 to=1.0 r=0.045 blend=0.007

  # Torso — ribcage tapering into a sagging gut.
  blob torso on spine  at=0.80 r=0.150 wide=1.28 deep=0.78 blend=0.014
  blob torso on spine  at=0.50 r=0.150 wide=1.15 deep=0.80 blend=0.02
  blob torso on spine  at=0.15 r=0.142 wide=1.02 deep=0.95 blend=0.02
  blob torso on pelvis at=0.40 r=0.145 wide=1.10 tall=0.9 deep=0.92 blend=0.02

  # Arms — shoulder blob, then upper and forearm capsules, then a fist.
  blob arm on clavicle at=0.90 r=0.072 blend=0.010 mirror
  bar  arm on upperArm from=0.02 to=0.95 r=0.055 blend=0.007 mirror
  bar  arm on foreArm  from=0.05 to=0.90 r=0.048 blend=0.007 mirror
  blob arm on foreArm  at=1.00 r=0.062 blend=0.0125 mirror

  # Legs — thigh, shin, foot.
  bar  leg on thigh from=0.05 to=0.95 r=0.082 blend=0.0175 mirror
  bar  leg on shin  from=0.05 to=0.92 r=0.062 blend=0.015 mirror
  blob leg on shin  at=1.00 r=0.070 wide=0.85 tall=0.6 deep=1.5 blend=0.0125 mirror

# Wound pass r2: hidden bone, revealed by a wound. Auto-derive (ratio 0.38)
# is right for limbs — a femur IS a thinner capsule inside the thigh — and
# wrong for the two places players actually shoot, which are authored here.
# The limb word is a REAL limb (head|torso|arm|leg), not "bone": the grammar
# has no `bone` limb, and the word is what gives the prim its cluster, i.e.
# which wounds can expose it.
bones
  ratio 0.38

  # SKULL — cranium + jaw.
  #
  # The first version was one blob at r=0.072 and the owner's read was "a
  # really small round ball, and there's no jaw of course" (playtest
  # 2026-09-02). It was small because it WAS small: the face block's head
  # ellipsoid has semi-axes ~(0.090, 0.137, 0.105), and a 0.072 sphere at 0.88/
  # 0.95/0.86 sits ~(0.063, 0.068, 0.062) — barely half the head it lives in,
  # so a headshot exposed a marble.
  blob head on skull at=0.56 r=0.086 wide=0.94 tall=1.06 deep=0.92
  # Jaw — dropped and jutted to follow the face block's own jaw (jawDrop 0.076,
  # jawJut 0.04). Separate from the cranium and hard-folded, so a blown-open
  # face reads as two bones meeting rather than one smooth helmet.
  blob head on skull at=0.30 offset=(0,-0.028,0.030) r=0.050 wide=0.82 tall=0.58 deep=0.96

  # RIBCAGE — real ribs, not a plate.
  #
  # The plate this replaces (`bar torso on spine ... wide=1.45 deep=0.55`) is
  # what the owner saw as "a big white central pillar running through the
  # torso" — because that is what it was. A slab cannot read as a ribcage no
  # matter how it is coloured; the shape has to carry it, and a wound only ever
  # opens a small window onto the bone, so the STRUCTURE inside that window is
  # the whole read.
  #
  # Each rib is a short bar whose far end is thrown out, down and forward by
  # `tip` (its bone runs vertically, the rib does not) and curved by `bend`.
  # `both` emits the mirrored pair — `mirror` is unavailable here because the
  # spine is not itself a mirrored bone.
  #
  # Kept well inside the torso flesh (half-width ~0.19, half-depth ~0.117 at
  # the chest): checkBoneContainment fails the build otherwise, and the
  # nearWound gate stops being an identity if a rib breaches.
  # Six pairs, and the CURVE is the whole point. The first version used
  # bend displacements of ~0.015 against a ~0.10 span, which is nearly
  # straight — the owner read them as "horizontal sticks" rather than a cage,
  # correctly, because that is what they were. A rib leaves the spine going
  # sideways and BACK, arcs out to its widest at the flank, then sweeps
  # forward and down to meet the sternum. That lateral arc is what reads as a
  # cage from inside a wound; without it you get louvres.
  #
  # Geometry per rib: a short vertical base segment on the spine, moved to the
  # spine's surface by `offset`, its far end thrown to the sternum by `tip`,
  # and bowed outward by `bend` (a control-point displacement from the chord
  # midpoint — the curve reaches midpoint + bend/2, so a 0.16 bend bulges
  # ~80 mm past the chord).
  #
  # Containment: the chest flesh is ~0.17 half-width, 0.12 half-depth. Widest
  # curve point lands near 0.12 including radius, so checkBoneContainment
  # passes with room. Upper ribs are shorter and flatter, middle ribs widest,
  # lower ribs shorter again and angled down — that taper is most of what
  # separates a ribcage from a stack of hoops.
  bar torso on spine from=0.78 to=0.80 offset=(0.014,0,-0.018) tip=(0.030,-0.020,0.070) bend=(0.105,0,-0.012) r=0.0085 both
  bar torso on spine from=0.68 to=0.70 offset=(0.015,0,-0.020) tip=(0.038,-0.026,0.082) bend=(0.140,0,-0.014) r=0.0090 both
  bar torso on spine from=0.58 to=0.60 offset=(0.015,0,-0.021) tip=(0.042,-0.030,0.086) bend=(0.160,0,-0.015) r=0.0090 both
  bar torso on spine from=0.48 to=0.50 offset=(0.015,0,-0.021) tip=(0.044,-0.034,0.086) bend=(0.162,0,-0.015) r=0.0090 both
  bar torso on spine from=0.38 to=0.40 offset=(0.014,0,-0.020) tip=(0.042,-0.038,0.078) bend=(0.146,0,-0.013) r=0.0085 both
  bar torso on spine from=0.28 to=0.30 offset=(0.013,0,-0.018) tip=(0.036,-0.040,0.066) bend=(0.118,0,-0.011) r=0.0080 both
  # Sternum — the front plate the ribs reach toward. Thin, so it reads as a
  # bone edge rather than a second pillar.
  bar torso on spine from=0.34 to=0.74 offset=(0,0,0.062) r=0.016 wide=1.5 deep=0.45
  # PELVIS — a landmark, not a lump (owner, 2026-09-02: "we need to add a
  # pelvic bone tbh, that's a major landmark").
  #
  # The previous version was ONE squashed blob, which is why it never read:
  # a pelvis is recognisable by its SHAPE — two blades flaring up and out from
  # a narrow centre, over a lower ring — and a single ellipsoid has none of
  # that. Same lesson the ribcage taught when it was a slab.
  #
  # Blades: wide, thin, tilted outward, mirrored with `both` (the pelvis bone
  # is not itself mirrored). Kept inside the hip flesh — the torso blob on
  # pelvis is r 0.145 at wide 1.10 / deep 0.92, so roughly 0.16 half-width.
  bar torso on pelvis from=0.34 to=0.52 offset=(0.030,0.004,0.004) tip=(0.062,0.030,-0.004) bend=(0.030,0.010,0.004) r=0.020 wide=1.15 deep=0.55 both
  # Ilium crest — the flare you actually see at the top of a hip.
  blob torso on pelvis at=0.54 offset=(0.070,0.026,0.000) r=0.024 wide=0.85 tall=0.60 deep=1.05 both
  # The basin floor, joining the two sides low and narrow.
  bar torso on pelvis from=0.16 to=0.30 offset=(0,-0.006,0.004) r=0.026 wide=1.30 tall=0.75 deep=0.80
  # Ischium masses — the sit bones, low and to each side.
  blob torso on pelvis at=0.14 offset=(0.036,-0.014,-0.006) r=0.021 wide=0.90 tall=0.80 deep=0.90 both

  # Spine rod — the column behind the ribs. Narrow on purpose: the pillar
  # complaint was a WIDE central mass, and a spine genuinely is a thin rod.
  bar torso on spine from=0.10 to=0.98 offset=(0,0,-0.030) r=0.019 wide=0.9 deep=0.8

  # GUT COIL (organs r3). Suggestive of the classic intestine look, not
  # anatomical — owner: "doesn't need to be anatomically correct, just
  # suggestive". The read is round tubes, visible loops, pale pink, wet.
  #
  # Only drawable since applyBones started reading bend (3dc8373); before
  # that every one of these would have rendered as a straight bar.
  bar torso on pelvis from=0.55 to=0.75 offset=(-0.045,0.010,0.030) tip=(0.090,0.010,0.006) bend=(0.010,0.055,0.030) r=0.024 organ
  bar torso on pelvis from=0.50 to=0.70 offset=(0.048,0.004,0.034) tip=(-0.092,0.014,-0.010) bend=(-0.012,-0.050,0.026) r=0.023 organ
  bar torso on pelvis from=0.72 to=0.92 offset=(-0.040,0.004,0.026) tip=(0.084,-0.008,-0.014) bend=(0.008,0.048,0.032) r=0.022 organ
  bar torso on spine  from=0.06 to=0.20 offset=(0.042,0.000,0.030) tip=(-0.086,-0.010,-0.008) bend=(-0.010,-0.044,0.028) r=0.022 organ
  # Segmented bulges: overlapping blobs at a tight blend read as haustra far
  # more cheaply than grooving a smooth tube.
  blob torso on pelvis at=0.62 offset=(-0.058,0.006,0.038) r=0.026 blend=0.004 organ
  blob torso on pelvis at=0.62 offset=(-0.020,0.014,0.042) r=0.025 blend=0.004 organ
  blob torso on pelvis at=0.62 offset=(0.020,0.010,0.042) r=0.025 blend=0.004 organ
  blob torso on pelvis at=0.62 offset=(0.058,0.002,0.038) r=0.026 blend=0.004 organ

# Tuned by hand in the panel, then baked. Keep headHeight near 1: raising it
# SHARPENS the crown rather than doming it, so the height and the gaunt taper
# both come from the jaw below.
face
  headRadius 0.118
  headWidth  0.76
  headHeight 1.161
  headDepth  0.894
  jawWidth   0.748
  jawHeight  0.861
  jawDrop    0.076
  jawJut     0.04
  noseLength 0.007
  noseWidth  0.379
  noseDrop   0.009
  browHeavy  0.008
  browRise   0.045
  headBlend  0.006
